---
interface Props {
  class?: string;
  as?: "div" | "h2" | "h3";
}
const props: Props = Astro.props;
const Tag = props.as ?? "div";
const extra = props.class ?? "";
---
<Tag class:list={["flex items-center gap-3", extra]}>
  <span class="block w-6 h-px bg-accent" aria-hidden="true"></span>
  <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent"><slot /></span>
</Tag>
