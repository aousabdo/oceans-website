---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Button from "@components/Button.astro";
import Stat from "@components/Stat.astro";
import ServiceCard from "@components/ServiceCard.astro";
import CaseStudyCard from "@components/CaseStudyCard.astro";
import Pipeline from "@components/Pipeline.astro";
import ParticleHeroCanvas from "@components/themes/operator/ParticleHeroCanvas.astro";
import CustomCursor from "@components/themes/operator/CustomCursor.astro";
import HudOverlay from "@components/themes/operator/HudOverlay.astro";
import MarqueeStrip from "@components/themes/operator/MarqueeStrip.astro";
import BlogPostCard from "@components/BlogPostCard.astro";
import { getCollection } from "astro:content";
import { readingTime } from "@lib/format";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
const cases = (await getCollection("caseStudies")).slice(0, 3);
const stack = [
  "Systems Engineering",
  "Enterprise Architecture",
  "RDT&E",
  "Ontology-Driven Data",
  "Federal Acquisition",
  "White Team Operations",
  "TRL Assessments",
  "CONOPS Development",
];
const pipelineSteps = [
  {
    label: "01 · Intake",
    title: "Mission Need & Scoping",
    description:
      "Surface the real operational gap, the decision it informs, and the threshold for done.",
    emphasis: true,
  },
  {
    label: "02 · Requirements",
    title: "Structured Requirements Development",
    description:
      "Decompose mission needs into testable requirements with full traceability from intent to threshold.",
  },
  {
    label: "03 · Architecture",
    title: "Systems Engineering & Design",
    description:
      "Bind validated requirements to integrated solutions across cyber, lifecycle, and operational constraints.",
  },
  {
    label: "04 · Evaluation",
    title: "T&E Execution & Analysis",
    description:
      "Run structured tests with quantitative analysis that withstands operational and acquisition review.",
  },
  {
    label: "05 · Outcome",
    title: "Decision-Grade Reporting",
    description:
      "Deliver evidence packages that work at technical, operational, and executive levels — and survive scrutiny.",
    emphasis: true,
  },
];
---
<PageLayout title="OCEANS LLC" path="/">
  <CustomCursor />

  <!-- HERO -->
  <section class="relative min-h-[640px] md:min-h-[720px] flex items-center overflow-hidden">
    <ParticleHeroCanvas />
    <HudOverlay />
    <div class="relative z-10 mx-auto max-w-6xl px-6 w-full py-24">
      <Eyebrow class="flex items-center gap-3">
        <span class="block w-10 h-px bg-accent"></span>
        Systems Engineering · T&amp;E · Mission Data
      </Eyebrow>
      <h1 class="font-display text-5xl md:text-7xl lg:text-[5rem] font-bold text-fg-strong mt-6 leading-[1.04] max-w-4xl">
        Engineering that<br />earns
        <em
          class="not-italic"
          style="color:transparent; -webkit-text-stroke:1.5px var(--color-accent);"
        >
          operational
        </em><br />trust.
      </h1>
      <p class="mt-7 text-lg text-muted max-w-xl leading-relaxed">
        OCEANS LLC delivers systems engineering, enterprise architecture, and rigorous test &amp;
        evaluation that translate federal mission needs into defensible, decision-ready outcomes.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/services" variant="primary">Explore capabilities</Button>
        <Button href="/capabilities" variant="outline">Download capabilities statement</Button>
      </div>
    </div>
    <div class="hidden lg:flex absolute right-12 bottom-16 z-10 flex-col gap-8 max-w-[260px]">
      <Stat value="50" emphasis="+" label="Years Combined Experience" align="right" />
      <Stat value="2013" label="Founded" align="right" />
      <Stat value="4" emphasis="+" label="Core Service Lines" align="right" />
    </div>
  </section>

  <MarqueeStrip items={stack} />

  <!-- CAPABILITIES -->
  <section class="bg-bg-2">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="flex items-end justify-between gap-12 flex-wrap">
        <div>
          <SectionLabel>Our Services</SectionLabel>
          <h2 class="font-display text-4xl md:text-5xl font-bold text-fg-strong mt-4 leading-tight">
            Four core<br />capability areas
          </h2>
        </div>
        <p class="text-muted max-w-sm leading-relaxed">
          Every engagement delivers defensible evidence — not just analysis — for operational and
          acquisition decisions.
        </p>
      </div>
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          services.map((s) => (
            <ServiceCard
              number={s.data.number}
              title={s.data.title}
              summary={s.data.summary}
              tags={s.data.tags}
              href={`/services/${s.data.slug}`}
              slug={s.data.slug}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- METHODOLOGY -->
  <section class="mx-auto max-w-6xl px-6 py-24 grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-16 items-start">
    <div class="lg:sticky lg:top-24">
      <SectionLabel>Our Methodology</SectionLabel>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-fg-strong mt-4 leading-tight">
        From mission need<br />to defensible outcome.
      </h2>
      <p class="mt-6 text-muted leading-relaxed">
        We don't hand off a report and walk away. Our end-to-end lifecycle process ensures every
        recommendation is traceable to a validated requirement and every metric withstands
        technical, operational, and executive review.
      </p>
      <div class="mt-8 flex items-center gap-3 font-mono text-[10px] uppercase tracking-widest text-muted">
        <span class="block w-8 h-px bg-accent"></span>
        Five-phase engagement lifecycle
      </div>
    </div>
    <Pipeline steps={pipelineSteps} class="max-w-xl" />
  </section>

  <!-- PAST PERFORMANCE -->
  <section class="bg-bg-2 border-y border-border-hairline">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <SectionLabel>Past Performance</SectionLabel>
      <div class="mt-4 flex items-end justify-between gap-8 flex-wrap">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-fg-strong leading-tight">
          Relevant experience<br />across federal missions
        </h2>
        <Button href="/experience" variant="outline">Request full past performance</Button>
      </div>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          cases.map((c) => (
            <CaseStudyCard
              client={c.data.client}
              title={c.data.title}
              summary={c.data.summary}
              badges={c.data.badges}
              href={`/experience/${c.data.slug}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FROM THE JOURNAL -->
  {recentPosts.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-24">
      <div class="flex items-end justify-between gap-8 flex-wrap mb-10">
        <div>
          <SectionLabel>From the journal</SectionLabel>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
            Recent thinking from the team.
          </h2>
        </div>
        <Button href="/blog" variant="outline" size="sm">All journal entries</Button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:divide-x md:divide-border-hairline">
        {recentPosts.map((p, i) => (
          <div class={i > 0 ? "md:pl-8" : ""}>
            <BlogPostCard
              title={p.data.title}
              date={p.data.date}
              author={p.data.author}
              excerpt={p.data.excerpt}
              readTime={readingTime(p.body ?? "")}
              href={`/blog/${p.id}`}
              tags={p.data.tags}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CTA BAND -->
  <section class="bg-surface border-y border-border-hairline">
    <div class="mx-auto max-w-6xl px-6 py-20 flex flex-col md:flex-row items-center justify-between gap-12">
      <div>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-fg-strong leading-tight">
          Ready to bring <em class="not-italic text-accent">rigor</em><br />to your program?
        </h2>
        <p class="mt-4 text-muted max-w-lg leading-relaxed">
          Whether you're scoping a new T&amp;E effort, need architecture support, or want to
          understand how OCEANS can support your acquisition — start with a conversation.
        </p>
      </div>
      <div class="flex flex-col gap-3 items-end shrink-0">
        <Button href="/contact" variant="primary">Schedule a conversation</Button>
        <Button href="/capabilities" variant="outline" size="sm">Capabilities ↓</Button>
        <p class="font-mono text-[10px] uppercase tracking-widest text-muted text-right">
          CAGE · NAICS · Contract vehicles inside
        </p>
      </div>
    </div>
  </section>
</PageLayout>
