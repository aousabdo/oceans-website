---
/**
 * HolidayCard — OCEANS, 2026.
 *
 * A 4:5 portrait card. The canonical [~] sits on the horizon; its brackets
 * open and fade, its wave repeats outward (by the path's own T-reflection)
 * into the horizon, the sea rises beneath it, and one light comes up on the
 * water for each person on /team.
 *
 * The finished frame is what the server renders. JS only rewinds it to the
 * start and plays it once the card scrolls into view, so the card is whole
 * with JS off, and under prefers-reduced-motion it simply stays still.
 * Motion is CSS transforms and opacity; it pauses off screen and has a
 * Pause/Play control (WCAG 2.2.2) and a Replay control.
 */
import { MARK } from "@lib/mark";
import { CARD, HORIZON_Y, HALF, waveSegments, wavePath, period, layoutLights, stars } from "@lib/sea";

interface Props {
  crew: { name: string }[];
}
const { crew } = Astro.props;

// The mark, centred on the horizon. S = card units per mark unit.
const S = 2.1;
const TX = CARD.w / 2 - 48 * S;
const TY = HORIZON_Y - 30 * S;

// Horizon: the tilde's two canonical segments plus copies either side,
// wide enough to cover the card while drifting by one full wavelength.
const SEG_FROM = 22 - 10 * HALF; // -238
const segs = waveSegments(SEG_FROM, 22 + 12 * HALF).map((d, idx) => {
  const k = Math.round((SEG_FROM - 22) / HALF) + idx;
  return { d, canonical: k === 0 || k === 1, dist: k < 0 ? -k : Math.max(0, k - 1) };
});

// Sea lines: nearer the viewer = lower, longer, taller, brighter, faster.
const seaLines = Array.from({ length: 12 }, (_, j) => {
  const t = (j + 1) / 12;
  const sx = 0.9 + 1.8 * t;
  const P = period(sx);
  return {
    d: wavePath({ x0: -2 * P, x1: CARD.w + 2 * P, baseY: HORIZON_Y + 520 * Math.pow(t, 1.5), sx, sy: 0.16 + 0.62 * t }),
    p: P.toFixed(2),
    sw: (0.8 + 1.5 * t).toFixed(2),
    o: (0.16 + 0.34 * t).toFixed(2),
    dur: (30 - 16 * t).toFixed(1),
    cream: j % 4 === 2,
  };
});

const lights = layoutLights(crew.length).map((p, i) => ({ ...p, name: crew[i]!.name }));
const sky = stars(42, 2026);

const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;
---
<figure class="hc" data-hc aria-labelledby="hc-greeting">
  <div class="hc-frame">
    <svg class="hc-art" viewBox={`0 0 ${CARD.w} ${CARD.h}`} aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="hc-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#020C1A" />
          <stop offset="0.7" stop-color="#061A30" />
          <stop offset="1" stop-color="#0C2848" />
        </linearGradient>
        <linearGradient id="hc-sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0A2341" />
          <stop offset="1" stop-color="#030E1C" />
        </linearGradient>
        <radialGradient id="hc-glow-horizon" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#D4A24A" stop-opacity="0.22" />
          <stop offset="1" stop-color="#D4A24A" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="hc-glow-light" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#FFE9BC" stop-opacity="1" />
          <stop offset="0.18" stop-color="#F0C46A" stop-opacity="0.6" />
          <stop offset="0.5" stop-color="#E7B95E" stop-opacity="0.16" />
          <stop offset="1" stop-color="#D4A24A" stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect width={CARD.w} height={HORIZON_Y} fill="url(#hc-sky)" />
      <rect y={HORIZON_Y} width={CARD.w} height={CARD.h - HORIZON_Y} fill="url(#hc-sea)" />
      <ellipse class="hc-glow" cx={CARD.w / 2} cy={HORIZON_Y} rx="380" ry="120" fill="url(#hc-glow-horizon)" />

      <g class="hc-stars">
        {sky.map((s, i) => (
          <circle class:list={[i % 5 === 0 && "tw"]} cx={s.x} cy={s.y} r={s.r} fill="#EBE3D0" opacity={s.o} style={`--o:${s.o};--d:${(i % 7) * 0.6}s`} />
        ))}
      </g>

      <g class="hc-sea">
        {seaLines.map((l, j) => (
          <g class="hc-row" style={`--i:${j}`}>
            <path
              class="hc-line"
              d={l.d}
              fill="none"
              stroke={l.cream ? "#EBE3D0" : "#7FB8E0"}
              stroke-width={l.sw}
              stroke-linecap="round"
              opacity={l.cream ? (Number(l.o) * 0.6).toFixed(2) : l.o}
              style={`--p:${l.p}px;--dur:${l.dur}s`}
            />
          </g>
        ))}
      </g>

      <g class="hc-lights">
        {lights.map((p, i) => (
          <g class="hc-light" style={`--i:${i}`}>
            <g class="hc-reflect">
              {[1, 2, 3, 4, 5].map((j) => (
                <line
                  x1={p.x - p.r * (2.6 - j * 0.32)}
                  x2={p.x + p.r * (2.6 - j * 0.32)}
                  y1={p.y + 4 + j * p.r * 1.9}
                  y2={p.y + 4 + j * p.r * 1.9}
                  stroke="#E7B95E"
                  stroke-width={Math.max(1, p.r * 0.5).toFixed(2)}
                  stroke-linecap="round"
                  opacity={(0.7 - j * 0.11).toFixed(2)}
                  style={`--d:${((i * 0.37 + j * 0.21) % 2).toFixed(2)}s`}
                />
              ))}
            </g>
            <circle class="hc-halo" cx={p.x} cy={p.y} r={p.r * 8} fill="url(#hc-glow-light)" style={`--d:${(i * 0.53) % 3}s`} />
            <circle cx={p.x} cy={p.y} r={p.r} fill="#FFF3D6" />
          </g>
        ))}
      </g>

      <!-- The mark: Logo.astro's exact paths, centred on the horizon. -->
      <g transform={`translate(${TX} ${TY}) scale(${S})`} fill="none" stroke="#EBE3D0">
        <path class="m-br m-br-l" d={MARK.D_LEFT} stroke-width={MARK.SW} stroke-linejoin="miter" stroke-linecap="square" />
        <path class="m-br m-br-r" d={MARK.D_RIGHT} stroke-width={MARK.SW} stroke-linejoin="miter" stroke-linecap="square" />
        <g class="m-horizon">
          <g class="m-drift">
            {segs.map((s) => (
              <path class:list={["m-seg", s.canonical && "is-mark"]} d={s.d} stroke-width={MARK.SW} stroke-linecap="round" style={`--k:${s.dist}`} />
            ))}
          </g>
        </g>
      </g>
    </svg>

    <div class="hc-greeting">
      <p class="hc-eyebrow">Season’s greetings</p>
      <p id="hc-greeting" class="hc-headline">Calm seas,<br /><em>bright lights.</em></p>
    </div>

    <ol class="hc-names" aria-label={`${lights.length} lights on the water, one for each of us`}>
      {lights.map((p, i) => (
        <li style={`left:${pct(p.x, CARD.w)};top:${pct(p.y + p.r + 12, CARD.h)};--i:${i}`}>{p.name}</li>
      ))}
    </ol>

    <p class="hc-sign">
      Happy holidays from all of us at <span class="hc-sign-word">OCEANS</span>
    </p>
  </div>

  <div class="hc-controls" hidden data-hc-controls>
    <button type="button" class="hc-btn" data-hc-pause>Pause</button>
    <button type="button" class="hc-btn" data-hc-replay>Replay</button>
  </div>
</figure>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-hc]");
    if (!root) return;
    var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (still || !("IntersectionObserver" in window)) return;

    var controls = root.querySelector("[data-hc-controls]");
    var pauseBtn = root.querySelector("[data-hc-pause]");
    var replayBtn = root.querySelector("[data-hc-replay]");
    controls.hidden = false;

    // Rewind to the first frame; play when the card is mostly in view.
    root.classList.add("is-pending");
    var played = false;
    var play = function () {
      root.classList.add("is-reset");
      root.classList.remove("is-playing");
      void root.offsetWidth;
      root.classList.remove("is-reset");
      root.classList.add("is-pending", "is-playing");
      played = true;
    };
    new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          var e = entries[i];
          root.classList.toggle("is-offscreen", !e.isIntersecting);
          if (e.isIntersecting && e.intersectionRatio >= 0.35 && !played) play();
        }
      },
      { threshold: [0, 0.35] }
    ).observe(root);

    pauseBtn.addEventListener("click", function () {
      var paused = !root.classList.contains("is-paused");
      root.classList.toggle("is-paused", paused);
      pauseBtn.textContent = paused ? "Play" : "Pause";
      // Pausing mid-intro jumps to the finished card instead of freezing it half-drawn.
      if (paused) root.classList.remove("is-pending", "is-playing");
    });
    replayBtn.addEventListener("click", function () {
      root.classList.remove("is-paused");
      pauseBtn.textContent = "Pause";
      play();
    });
  })();
</script>

<style>
  .hc {
    margin: 0;
    width: 100%;
  }
  .hc-frame {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(127, 184, 224, 0.2);
    background: #061a30;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(6, 26, 48, 0.6);
  }
  .hc-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Finished frame (the default, no JS needed) ─────────────────── */
  .m-br {
    opacity: 0;
  }
  .m-br-l {
    transform: translateX(-70px);
  }
  .m-br-r {
    transform: translateX(70px);
  }
  .m-horizon {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: scaleY(0.32);
  }
  .hc-light {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  /* ── Overlay text ─────────────────────────────────────────────────── */
  .hc-greeting {
    position: absolute;
    inset: 7% 8% auto;
    text-align: center;
  }
  .hc-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(10px, 2.1cqw, 12px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #d4a24a;
  }
  .hc-headline {
    margin-top: 0.5em;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 9cqw, 52px);
    line-height: 1.02;
    color: #f6f1e6;
  }
  .hc-headline em {
    color: #e7b95e;
  }
  .hc-names {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hc-names li {
    position: absolute;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.95cqw, 11px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ebe3d0;
    text-shadow: 0 1px 6px #030e1c, 0 0 2px #030e1c;
  }
  .hc-sign {
    position: absolute;
    inset: auto 6% 4.2%;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(15px, 3.6cqw, 21px);
    color: #ebe3d0;
    text-shadow: 0 1px 8px #030e1c;
  }
  .hc-sign-word {
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .hc-controls {
    margin-top: 0.9rem;
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }
  .hc-controls[hidden] {
    display: none;
  }
  .hc-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ebe3d0;
    border: 1px solid rgba(127, 184, 224, 0.4);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    min-height: 40px;
    min-width: 88px;
    background: transparent;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .hc-btn:hover {
    border-color: #7fb8e0;
    background: rgba(127, 184, 224, 0.08);
  }
  .hc-btn:focus-visible {
    outline: 2px solid #7fb8e0;
    outline-offset: 2px;
  }

  /* ── First frame (JS rewinds to here before playing) ─────────────── */
  .is-pending:not(.is-playing) .m-br {
    opacity: 1;
    transform: none;
  }
  .is-pending:not(.is-playing) .m-horizon {
    transform: none;
  }
  .is-pending:not(.is-playing) .m-seg:not(.is-mark),
  .is-pending:not(.is-playing) .hc-stars,
  .is-pending:not(.is-playing) .hc-glow,
  .is-pending:not(.is-playing) .hc-names li,
  .is-pending:not(.is-playing) .hc-sign {
    opacity: 0;
  }
  .is-pending:not(.is-playing) .hc-row {
    opacity: 0;
    transform: translateY(-14px);
  }
  .is-pending:not(.is-playing) .hc-light {
    opacity: 0;
    transform: scale(0.3);
  }
  .is-pending:not(.is-playing) .hc-greeting {
    opacity: 0;
    transform: translateY(10px);
  }

  /* ── The timeline ─────────────────────────────────────────────────── */
  .is-playing .hc-glow,
  .is-playing .hc-stars {
    transition: opacity 1.8s ease 0.2s;
  }
  .is-playing .m-br {
    transition:
      transform 1.3s cubic-bezier(0.6, 0, 0.3, 1) 0.9s,
      opacity 1s ease 1.2s;
  }
  .is-playing .m-seg {
    transition: opacity 0.5s ease calc(1.1s + var(--k) * 0.07s);
  }
  .is-playing .m-horizon {
    transition: transform 1.4s cubic-bezier(0.5, 0, 0.2, 1) 2.2s;
  }
  .is-playing .hc-row {
    transition:
      opacity 1.2s ease calc(2.6s + var(--i) * 0.09s),
      transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) calc(2.6s + var(--i) * 0.09s);
  }
  .is-playing .hc-light {
    transition:
      opacity 0.9s ease calc(3.7s + var(--i) * 0.22s),
      transform 1.1s cubic-bezier(0.2, 0.9, 0.2, 1.2) calc(3.7s + var(--i) * 0.22s);
  }
  .is-playing .hc-names li {
    transition: opacity 0.9s ease calc(4s + var(--i) * 0.22s);
  }
  .is-playing .hc-greeting {
    transition:
      opacity 1.2s ease 5.6s,
      transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 5.6s;
  }
  .is-playing .hc-sign {
    transition: opacity 1.2s ease 6.3s;
  }

  /* ── Ambient motion: only for people who haven't asked for less ──── */
  @media (prefers-reduced-motion: no-preference) {
    .m-drift {
      animation: hc-drift-mark 11s linear infinite;
    }
    .hc-line {
      animation: hc-drift var(--dur) linear infinite;
    }
    .hc-halo {
      animation: hc-twinkle 3.6s ease-in-out var(--d) infinite alternate;
    }
    .hc-reflect line {
      animation: hc-shimmer 1.9s ease-in-out var(--d) infinite alternate;
    }
    .hc-stars .tw {
      animation: hc-star 4.2s ease-in-out var(--d) infinite alternate;
    }
    .is-pending:not(.is-playing) .m-drift,
    .is-pending:not(.is-playing) .hc-line {
      animation-play-state: paused;
    }
    .is-playing .m-drift {
      animation-delay: 3.6s;
    }
    .is-paused *,
    .is-offscreen * {
      animation-play-state: paused !important;
    }
    .is-reset * {
      animation: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-controls {
      display: none;
    }
  }

  @keyframes hc-drift {
    to {
      transform: translateX(calc(var(--p) * -1));
    }
  }
  @keyframes hc-drift-mark {
    to {
      transform: translateX(-52px);
    }
  }
  @keyframes hc-twinkle {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.55;
    }
  }
  @keyframes hc-star {
    from {
      opacity: var(--o);
    }
    to {
      opacity: calc(var(--o) * 0.3);
    }
  }
  @keyframes hc-shimmer {
    from {
      transform: translateX(-1.5px);
    }
    to {
      transform: translateX(1.5px);
      opacity: 0.15;
    }
  }
</style>
