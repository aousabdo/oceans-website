---
// Thin scroll-progress bar fixed to the top of the viewport. Used on long
// editorial pages (blog posts, case-study detail). Element it tracks is
// passed via the `target` selector; defaults to `main`.
interface Props {
  target?: string;
}
const props = Astro.props as Props;
const { target = "main" } = props;
---
<div
  id="reading-progress"
  data-target={target}
  class="fixed top-0 left-0 right-0 h-[3px] z-50 pointer-events-none"
  aria-hidden="true"
>
  <div
    id="reading-progress-bar"
    class="h-full bg-gradient-to-r from-accent via-accent to-accent-2 origin-left transition-transform"
    style="transform: scaleX(0); transform-origin: left;"
  ></div>
</div>
<script>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Reduced motion: keep the bar present but skip the smooth transition
      const bar = document.getElementById("reading-progress-bar");
      if (bar) (bar as HTMLElement).style.transition = "none";
    }
    const wrap = document.getElementById("reading-progress");
    const bar = document.getElementById("reading-progress-bar");
    if (!wrap || !bar) return;

    const selector = wrap.dataset.target || "main";
    const target = document.querySelector<HTMLElement>(selector);
    if (!target) return;

    let ticking = false;
    const update = () => {
      const rect = target.getBoundingClientRect();
      const viewportH = window.innerHeight;
      const total = rect.height - viewportH;
      const scrolled = -rect.top;
      const ratio = total > 0 ? Math.max(0, Math.min(1, scrolled / total)) : 0;
      bar.style.transform = `scaleX(${ratio})`;
    };
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  })();
</script>
