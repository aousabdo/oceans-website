---
interface Step {
  label: string;
  title: string;
  description?: string;
  emphasis?: boolean;
}
interface Props {
  steps: Step[];
  class?: string;
}
const props = Astro.props as Props;
const { steps, class: extra = "" } = props;
---
<ol class:list={["relative", extra]}>
  {
    steps.map((s, i) => (
      <li class="relative grid grid-cols-[auto_1fr] gap-5 md:gap-7">
        {/* number column with connecting line through it */}
        <div class="relative flex flex-col items-center">
          <div
            class:list={[
              "relative z-10 w-14 h-14 md:w-16 md:h-16 rounded-md grid place-items-center font-display font-bold text-xl md:text-2xl shrink-0 transition-colors",
              s.emphasis
                ? "bg-accent text-bg border border-accent shadow-[0_8px_24px_-8px_var(--color-accent)]"
                : "bg-surface border border-accent/30 text-accent",
            ]}
          >
            {String(i + 1).padStart(2, "0")}
          </div>
          {i < steps.length - 1 && (
            <div class="flex-1 w-px my-2 bg-gradient-to-b from-accent/40 via-accent/20 to-accent/40" />
          )}
        </div>
        {/* content card */}
        <div
          class:list={[
            "min-w-0 mb-8 last:mb-0 p-5 md:p-6 rounded-lg border transition-all hover:border-accent/40 hover:translate-x-0.5",
            s.emphasis
              ? "border-accent/40 bg-surface-2/40"
              : "border-border-hairline bg-surface",
          ]}
        >
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">
            {s.label}
          </div>
          <div class="font-display text-lg md:text-xl font-bold text-fg-strong mt-1.5 leading-tight">
            {s.title}
          </div>
          {s.description && (
            <p class="mt-2.5 text-sm text-muted leading-relaxed">{s.description}</p>
          )}
        </div>
      </li>
    ))
  }
</ol>
