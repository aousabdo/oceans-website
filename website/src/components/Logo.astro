---
// Canonical OCEANS LLC logo — the Bracketed mark: square brackets `[~]`
// enclosing a single wave. Scientific notation meets ocean. Geometric,
// modern, monochrome-safe, holds up at favicon size.
//
// Picked by Danny + Paul on 2026-06-15 ("really like [~] as our own
// little logo / emoji. Simple, clean, isn't a specific jpg or anything").
// The mark is paired with "OCEANS" in the active theme's display font
// (Mariner = Cormorant Garamond).
//
// Variants:
//   full      — `[~] OCEANS` lockup (default; for nav/footer)
//   mark      — just `[~]` (for favicon, badges, watermarks, social emoji)
//   wordmark  — just "OCEANS" (rare; for footnotes)
//
// All strokes use currentColor so the mark picks up whatever text color
// is in scope. The mark's natural aspect ratio is 2:1.

interface Props {
  variant?: "full" | "mark" | "wordmark";
  size?: "sm" | "md" | "lg";
  class?: string;
}
const props = Astro.props as Props;
const { variant = "full", size = "md", class: extra = "" } = props;

// Mark width = 2x mark height (the natural aspect of `[~]`).
const sizes = {
  sm: { markH: 22, word: 18, gap: "5px" },
  md: { markH: 28, word: 22, gap: "6px" },
  lg: { markH: 44, word: 36, gap: "8px" },
}[size];
---
{variant === "mark" && (
  <svg
    viewBox="0 0 120 60"
    width={sizes.markH * 2}
    height={sizes.markH}
    role="img"
    aria-label="OCEANS LLC"
    class:list={[extra]}
  >
    {/* Left bracket */}
    <path
      d="M 22 8 L 12 8 L 12 52 L 22 52"
      fill="none"
      stroke="currentColor"
      stroke-width="4"
      stroke-linejoin="miter"
      stroke-linecap="square"
    />
    {/* Right bracket */}
    <path
      d="M 98 8 L 108 8 L 108 52 L 98 52"
      fill="none"
      stroke="currentColor"
      stroke-width="4"
      stroke-linejoin="miter"
      stroke-linecap="square"
    />
    {/* Wave */}
    <path
      d="M 28 30 Q 42 18 60 30 T 92 30"
      fill="none"
      stroke="currentColor"
      stroke-width="4"
      stroke-linecap="round"
    />
  </svg>
)}
{variant === "wordmark" && (
  <span
    class:list={["font-display font-bold uppercase", extra]}
    style={`letter-spacing:0.16em; font-size:${sizes.word}px;`}
  >
    OCEANS
  </span>
)}
{variant === "full" && (
  <span
    class:list={["inline-flex items-center", extra]}
    style={`gap:${sizes.gap}; color:inherit;`}
    aria-label="OCEANS LLC"
  >
    <svg
      viewBox="0 0 120 60"
      width={sizes.markH * 2}
      height={sizes.markH}
      aria-hidden="true"
      style="flex-shrink:0;"
    >
      <path
        d="M 22 8 L 12 8 L 12 52 L 22 52"
        fill="none"
        stroke="currentColor"
        stroke-width="4"
        stroke-linejoin="miter"
        stroke-linecap="square"
      />
      <path
        d="M 98 8 L 108 8 L 108 52 L 98 52"
        fill="none"
        stroke="currentColor"
        stroke-width="4"
        stroke-linejoin="miter"
        stroke-linecap="square"
      />
      <path
        d="M 28 30 Q 42 18 60 30 T 92 30"
        fill="none"
        stroke="currentColor"
        stroke-width="4"
        stroke-linecap="round"
      />
    </svg>
    <span
      class="font-display font-bold uppercase"
      style={`letter-spacing:0.16em; font-size:${sizes.word}px;`}
    >
      OCEANS
    </span>
  </span>
)}
