---
// Canonical OCEANS LLC logo — wave-O mark + "CEANS" wordmark in the active
// theme's display font. The mark uses currentColor so it picks up whatever
// text color is in scope.
//
// Variants:
//   full      — mark + wordmark side by side (default; for nav/footer)
//   mark      — just the wave-O mark (for favicon, badges, watermarks)
//   wordmark  — just "OCEANS" wordmark (rare; for footnotes)
//
// The wordmark uses the active theme's --font-display so each theme
// produces a slightly different lockup personality while the mark stays
// constant. After Danny picks a theme, that theme's font becomes the
// canonical brand font.

interface Props {
  variant?: "full" | "mark" | "wordmark";
  size?: "sm" | "md" | "lg";
  class?: string;
}
const props = Astro.props as Props;
const { variant = "full", size = "md", class: extra = "" } = props;

const sizes = {
  sm: { mark: 28, word: 18, gap: "3px" },
  md: { mark: 36, word: 22, gap: "4px" },
  lg: { mark: 56, word: 36, gap: "6px" },
}[size];

const id = `logo-${size}-${Math.random().toString(36).slice(2, 8)}`;
---
{variant === "mark" && (
  <svg
    viewBox="0 0 100 100"
    width={sizes.mark}
    height={sizes.mark}
    role="img"
    aria-label="OCEANS LLC"
    class:list={[extra]}
  >
    <defs><clipPath id={id}><circle cx="50" cy="50" r="38" /></clipPath></defs>
    <circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="6" />
    <g clip-path={`url(#${id})`}>
      <path
        d="M 5 52 Q 22 42 38 52 T 70 52 T 102 52"
        fill="none"
        stroke="currentColor"
        stroke-width="6"
        stroke-linecap="round"
      />
    </g>
  </svg>
)}
{variant === "wordmark" && (
  <span
    class:list={["font-display font-bold uppercase", extra]}
    style={`letter-spacing:0.16em; font-size:${sizes.word}px;`}
  >
    OCEANS
  </span>
)}
{variant === "full" && (
  <span
    class:list={["inline-flex items-center", extra]}
    style={`gap:${sizes.gap}; color:inherit;`}
    aria-label="OCEANS LLC"
  >
    <svg
      viewBox="0 0 100 100"
      width={sizes.mark}
      height={sizes.mark}
      aria-hidden="true"
      style="flex-shrink:0;"
    >
      <defs><clipPath id={id}><circle cx="50" cy="50" r="38" /></clipPath></defs>
      <circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="6" />
      <g clip-path={`url(#${id})`}>
        <path
          d="M 5 52 Q 22 42 38 52 T 70 52 T 102 52"
          fill="none"
          stroke="currentColor"
          stroke-width="6"
          stroke-linecap="round"
        />
      </g>
    </svg>
    <span
      class="font-display font-bold uppercase"
      style={`letter-spacing:0.16em; font-size:${sizes.word}px;`}
    >
      CEANS
    </span>
  </span>
)}
