---
// Canonical OCEANS LLC logo — the Bracketed mark: square brackets `[~]`
// enclosing a single wave. Scientific notation meets ocean. Geometric,
// modern, monochrome-safe, holds up at favicon size.
//
// Picked by Danny + Paul on 2026-06-15 ("really like [~] as our own
// little logo / emoji. Simple, clean, isn't a specific jpg or anything").
// The mark is paired with "OCEANS" in the active theme's display font
// (Mariner = Cormorant Garamond).
//
// Variants:
//   full      — `[~] OCEANS` lockup (default; for nav/footer)
//   mark      — just `[~]` (for favicon, badges, watermarks, social emoji)
//   wordmark  — just "OCEANS" (rare; for footnotes)
//
// All strokes use currentColor so the mark picks up whatever text color
// is in scope. The mark's natural aspect ratio is ~1.6:1 (was 2:1 — the
// brackets sat too far apart and the lockup felt visually unbalanced).

interface Props {
  variant?: "full" | "mark" | "wordmark";
  size?: "sm" | "md" | "lg";
  class?: string;
}
const props = Astro.props as Props;
const { variant = "full", size = "md", class: extra = "" } = props;

// Mark scaled to roughly 0.8x the wordmark cap height so it reads as an
// accent next to the wordmark, not as a peer.
const sizes = {
  sm: { markH: 14, word: 18, gap: "6px" },
  md: { markH: 18, word: 22, gap: "7px" },
  lg: { markH: 28, word: 36, gap: "10px" },
}[size];

// Tighter geometry: viewBox 96×60 (1.6:1) with bracket-to-bracket inside
// span of 60 units (vs 76 prior). The whole mark renders narrower.
const VB = "0 0 96 60";
const D_LEFT  = "M 18 10 L 10 10 L 10 50 L 18 50";
const D_RIGHT = "M 78 10 L 86 10 L 86 50 L 78 50";
const D_WAVE  = "M 22 30 Q 34 18 48 30 T 74 30";
const SW = 4;
const markW = Math.round(sizes.markH * 1.6);
---
{variant === "mark" && (
  <svg
    viewBox={VB}
    width={markW}
    height={sizes.markH}
    role="img"
    aria-label="OCEANS LLC"
    class:list={[extra]}
  >
    <path d={D_LEFT}  fill="none" stroke="currentColor" stroke-width={SW} stroke-linejoin="miter" stroke-linecap="square" />
    <path d={D_RIGHT} fill="none" stroke="currentColor" stroke-width={SW} stroke-linejoin="miter" stroke-linecap="square" />
    <path d={D_WAVE}  fill="none" stroke="currentColor" stroke-width={SW} stroke-linecap="round" />
  </svg>
)}
{variant === "wordmark" && (
  <span
    class:list={["font-display font-bold uppercase", extra]}
    style={`letter-spacing:0.16em; font-size:${sizes.word}px;`}
  >
    OCEANS
  </span>
)}
{variant === "full" && (
  <span
    class:list={["inline-flex items-center", extra]}
    style={`gap:${sizes.gap}; color:inherit;`}
    aria-label="OCEANS LLC"
  >
    <svg
      viewBox={VB}
      width={markW}
      height={sizes.markH}
      aria-hidden="true"
      style="flex-shrink:0;"
    >
      <path d={D_LEFT}  fill="none" stroke="currentColor" stroke-width={SW} stroke-linejoin="miter" stroke-linecap="square" />
      <path d={D_RIGHT} fill="none" stroke="currentColor" stroke-width={SW} stroke-linejoin="miter" stroke-linecap="square" />
      <path d={D_WAVE}  fill="none" stroke="currentColor" stroke-width={SW} stroke-linecap="round" />
    </svg>
    <span
      class="font-display font-bold uppercase"
      style={`letter-spacing:0.16em; font-size:${sizes.word}px;`}
    >
      OCEANS
    </span>
  </span>
)}
