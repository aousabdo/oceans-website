---
interface Props {
  title: string;
  location: string;
  level: string;
  type: string;
  href: string;
}
const props = Astro.props as Props;
const { title, location, level, type, href } = props;
---
<a
  href={href}
  class="group block bg-surface border border-border-hairline rounded p-6 transition-all hover:border-accent/40"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-display text-lg font-bold text-fg-strong group-hover:text-accent transition-colors">
        {title}
      </h3>
      <div class="mt-2 flex gap-3 font-mono text-[10px] uppercase tracking-widest text-muted">
        <span>{level}</span><span>·</span><span>{type}</span><span>·</span><span>{location}</span>
      </div>
    </div>
    <span class="font-mono text-xs text-accent group-hover:translate-x-1 transition-transform">→</span>
  </div>
</a>
