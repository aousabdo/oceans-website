---
interface Logo {
  src: string;
  alt: string;
  href?: string;
}
interface Props {
  logos: Logo[];
  cols?: 3 | 4 | 5 | 6;
  class?: string;
}
const { logos, cols = 5, class: extra = "" } = Astro.props;
const gridCols = {
  3: "grid-cols-2 md:grid-cols-3",
  4: "grid-cols-2 md:grid-cols-4",
  5: "grid-cols-3 md:grid-cols-5",
  6: "grid-cols-3 md:grid-cols-6",
}[cols];
---
<ul class:list={["grid items-center gap-8", gridCols, extra]}>
  {
    logos.map((l) => (
      <li class="flex items-center justify-center">
        {l.href ? (
          <a href={l.href} aria-label={l.alt}>
            <img
              src={l.src}
              alt={l.alt}
              loading="lazy"
              class="max-h-12 opacity-80 hover:opacity-100 transition-opacity"
            />
          </a>
        ) : (
          <img src={l.src} alt={l.alt} loading="lazy" class="max-h-12 opacity-80" />
        )}
      </li>
    ))
  }
</ul>
