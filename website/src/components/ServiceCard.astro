---
import Tag from "./Tag.astro";

interface Props {
  number: string;
  title: string;
  summary: string;
  tags?: string[];
  href: string;
}
const props = Astro.props as Props;
const { number, title, summary, tags = [], href } = props;
---
<a
  href={href}
  class="group block bg-surface border border-border-hairline rounded p-8 transition-all hover:bg-surface-2 hover:border-accent/40 relative overflow-hidden"
>
  <span
    class="absolute top-0 left-0 right-0 h-px bg-accent scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"
  ></span>
  <div class="font-mono text-[11px] tracking-widest text-accent">{number}</div>
  <h3 class="font-display text-xl font-bold text-fg-strong mt-6 leading-tight">{title}</h3>
  <p class="mt-3 text-sm text-muted leading-relaxed">{summary}</p>
  {
    tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <Tag>{t}</Tag>
        ))}
      </div>
    )
  }
</a>
