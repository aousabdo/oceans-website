---
interface Props {
  value: string;
  label: string;
  emphasis?: string;
  align?: "left" | "right";
}
const props = Astro.props as Props;
const { value, label, emphasis, align = "left" } = props;
---
<div class={align === "right" ? "text-right" : "text-left"}>
  <div class="font-display text-5xl md:text-6xl font-bold text-fg-strong leading-none tracking-tight">
    {value}{emphasis && <span class="text-accent">{emphasis}</span>}
  </div>
  <div class="mt-3 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
    {label}
  </div>
</div>
