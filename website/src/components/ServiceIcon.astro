---
interface Props {
  slug: string;
  size?: number;
  class?: string;
}
const props = Astro.props as Props;
const { slug, size = 28, class: extra = "" } = props;
const cls = `text-accent ${extra}`;
const w = size;
const h = size;
---
{
  slug === "requirements" && (
    <svg width={w} height={h} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      <rect x="6" y="4" width="20" height="24" rx="2" />
      <path d="M10 9h12M10 14h12M10 19h8M10 24h6" />
      <path d="M20 24l3 3 5-5" stroke-width="2" />
    </svg>
  )
}
{
  slug === "systems-engineering" && (
    <svg width={w} height={h} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      <rect x="4" y="4" width="10" height="10" rx="1.5" />
      <rect x="18" y="4" width="10" height="10" rx="1.5" />
      <rect x="11" y="18" width="10" height="10" rx="1.5" />
      <path d="M9 14v2M23 14v2M16 16v2" />
      <circle cx="9" cy="14" r="1" fill="currentColor" stroke="none" />
      <circle cx="23" cy="14" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  slug === "rdte" && (
    <svg width={w} height={h} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      <path d="M5 26 L11 18 L16 22 L21 14 L27 18" />
      <circle cx="11" cy="18" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="16" cy="22" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="21" cy="14" r="1.5" fill="currentColor" stroke="none" />
      <path d="M5 28h22M5 4v22" />
      <path d="M24 6l4 4-4 4" stroke-width="1" stroke-dasharray="2 2" opacity="0.6" />
    </svg>
  )
}
{
  slug === "mission-data" && (
    <svg width={w} height={h} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      <circle cx="16" cy="16" r="3" />
      <circle cx="6" cy="8" r="2" />
      <circle cx="26" cy="8" r="2" />
      <circle cx="6" cy="24" r="2" />
      <circle cx="26" cy="24" r="2" />
      <path d="M8 8 L14 14 M24 8 L18 14 M8 24 L14 18 M24 24 L18 18" />
      <circle cx="16" cy="16" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
