---
// Larger, technical-sketch style illustrations per capability — for service
// detail page heroes and capabilities page. Uses currentColor so it picks up
// each theme's accent automatically.
interface Props {
  slug: string;
  class?: string;
}
const props = Astro.props as Props;
const { slug, class: extra = "" } = props;
const cls = `text-accent ${extra}`;
---
{
  slug === "requirements" && (
    <svg viewBox="0 0 200 140" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      {/* Document — outer */}
      <rect x="14" y="14" width="78" height="112" rx="2" />
      <path d="M14 24h78M14 38h78" stroke-width="0.7" opacity="0.6" />
      {/* Document header bars */}
      <path d="M22 19h22M22 30h36M22 43h18" stroke-width="2" opacity="0.55" />
      {/* Body items with checkboxes */}
      <g opacity="0.85">
        <rect x="22" y="54" width="6" height="6" rx="1" />
        <path d="M22 57l3 3 6-7" stroke-width="1.4" />
        <path d="M34 57h44" stroke-width="0.8" />
      </g>
      <g opacity="0.7">
        <rect x="22" y="68" width="6" height="6" rx="1" />
        <path d="M22 71l3 3 6-7" stroke-width="1.4" />
        <path d="M34 71h38" stroke-width="0.8" />
      </g>
      <g opacity="0.5">
        <rect x="22" y="82" width="6" height="6" rx="1" />
        <path d="M34 85h32" stroke-width="0.8" />
      </g>
      <g opacity="0.35">
        <rect x="22" y="96" width="6" height="6" rx="1" />
        <path d="M34 99h26" stroke-width="0.8" />
      </g>
      <g opacity="0.25">
        <rect x="22" y="110" width="6" height="6" rx="1" />
        <path d="M34 113h20" stroke-width="0.8" />
      </g>
      {/* Connection lines — document to tree on the right */}
      <path d="M92 60h22M114 60v14M114 74h26M114 88h26" stroke-dasharray="2 2" opacity="0.55" />
      {/* Hierarchy/tree — requirements decomposition */}
      <g transform="translate(140 50)">
        <rect x="0" y="0" width="46" height="18" rx="2" />
        <path d="M10 9h26" stroke-width="0.8" />
        <path d="M23 18v8M9 26v8M37 26v8" stroke-width="0.7" opacity="0.7" />
        <rect x="0" y="34" width="20" height="14" rx="2" opacity="0.85" />
        <rect x="26" y="34" width="20" height="14" rx="2" opacity="0.85" />
        <path d="M5 41h10M31 41h10" stroke-width="0.7" opacity="0.6" />
        {/* leaf nodes */}
        <path d="M10 48v6M36 48v6" stroke-width="0.6" opacity="0.5" />
        <circle cx="10" cy="56" r="2" fill="currentColor" stroke="none" opacity="0.7" />
        <circle cx="36" cy="56" r="2" fill="currentColor" stroke="none" opacity="0.7" />
      </g>
    </svg>
  )
}
{
  slug === "systems-engineering" && (
    <svg viewBox="0 0 200 140" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      {/* Outer system frame */}
      <rect x="14" y="14" width="172" height="112" rx="3" stroke-dasharray="3 3" opacity="0.4" />
      {/* Subsystem A */}
      <rect x="26" y="30" width="48" height="32" rx="2" />
      <path d="M32 38h36M32 46h28M32 54h22" stroke-width="0.8" opacity="0.6" />
      {/* Subsystem B */}
      <rect x="86" y="30" width="48" height="32" rx="2" />
      <circle cx="110" cy="46" r="9" />
      <circle cx="110" cy="46" r="3" fill="currentColor" stroke="none" />
      {/* Subsystem C */}
      <rect x="146" y="30" width="40" height="32" rx="2" />
      <path d="M154 38l28 0M154 46l24 0M154 54l28 0" stroke-width="0.8" opacity="0.6" />
      {/* Lower */}
      <rect x="46" y="80" width="48" height="30" rx="2" />
      <path d="M52 88l8 6 12-9 8 4 12-7" stroke-width="1.3" />
      <circle cx="60" cy="94" r="2" fill="currentColor" stroke="none" />
      <circle cx="72" cy="85" r="2" fill="currentColor" stroke="none" />
      <circle cx="80" cy="89" r="2" fill="currentColor" stroke="none" />
      <rect x="110" y="80" width="40" height="30" rx="2" />
      <path d="M118 88h24M118 96h20M118 104h22" stroke-width="0.8" opacity="0.6" />
      {/* Interconnection wires */}
      <path d="M74 46h12M134 46h12M70 62v12M120 62v18M160 62v18" stroke-dasharray="2 2" opacity="0.7" />
      <circle cx="74" cy="46" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="86" cy="46" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="134" cy="46" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="146" cy="46" r="1.5" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  slug === "rdte" && (
    <svg viewBox="0 0 200 140" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      {/* Chart frame */}
      <path d="M22 110V22M22 110h160" stroke-width="1.3" />
      {/* Axis ticks */}
      <g opacity="0.4">
        <path d="M22 92h-3M22 74h-3M22 56h-3M22 38h-3M50 110v3M86 110v3M122 110v3M158 110v3" />
      </g>
      {/* Grid */}
      <g opacity="0.18" stroke-dasharray="2 3">
        <path d="M22 92h160M22 74h160M22 56h160M22 38h160" />
      </g>
      {/* Data path with smooth curve */}
      <path
        d="M30 96 C 50 92, 60 78, 70 70 S 96 80, 110 60 S 138 36, 154 30 L 178 26"
        stroke-width="1.6"
      />
      {/* Data points */}
      <g fill="currentColor" stroke="none">
        <circle cx="30" cy="96" r="2.5" />
        <circle cx="70" cy="70" r="2.5" />
        <circle cx="110" cy="60" r="2.5" />
        <circle cx="154" cy="30" r="2.5" />
        <circle cx="178" cy="26" r="2.5" />
      </g>
      {/* Threshold line */}
      <path d="M22 48h160" stroke-dasharray="4 3" opacity="0.55" />
      <text x="186" y="52" font-family="ui-monospace, monospace" font-size="6" fill="currentColor" opacity="0.6" stroke="none">THRESHOLD</text>
      {/* Error bars on a couple of points */}
      <g opacity="0.55" stroke-width="0.9">
        <path d="M70 64v12M66 64h8M66 76h8" />
        <path d="M110 54v12M106 54h8M106 66h8" />
      </g>
      {/* Confidence band */}
      <path
        d="M30 100 C 50 96, 60 82, 70 76 S 96 86, 110 66 S 138 42, 154 36 L 178 32 L 178 22 C 154 26, 138 32, 122 38 S 96 70, 70 64 S 50 86, 30 90 Z"
        fill="currentColor"
        opacity="0.06"
        stroke="none"
      />
    </svg>
  )
}
{
  slug === "mission-data" && (
    <svg viewBox="0 0 200 140" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class={cls}>
      {/* Outer perimeter — domain boundary */}
      <circle cx="100" cy="70" r="62" stroke-dasharray="3 4" opacity="0.25" />
      {/* Central hub */}
      <circle cx="100" cy="70" r="14" />
      <circle cx="100" cy="70" r="5" fill="currentColor" stroke="none" />
      {/* Inner ring — primary connections */}
      <g>
        <circle cx="40" cy="40" r="7" />
        <circle cx="160" cy="40" r="7" />
        <circle cx="40" cy="100" r="7" />
        <circle cx="160" cy="100" r="7" />
        <circle cx="100" cy="22" r="7" />
        <circle cx="100" cy="118" r="7" />
      </g>
      {/* Primary edges */}
      <path d="M47 40 L 88 64 M153 40 L 112 64 M47 100 L 88 76 M153 100 L 112 76 M100 29 L 100 56 M100 111 L 100 84" stroke-width="1.1" />
      {/* Outer ring — secondary nodes */}
      <g opacity="0.7">
        <circle cx="20" cy="70" r="4" />
        <circle cx="180" cy="70" r="4" />
        <circle cx="60" cy="20" r="4" />
        <circle cx="140" cy="20" r="4" />
        <circle cx="60" cy="120" r="4" />
        <circle cx="140" cy="120" r="4" />
      </g>
      <g stroke-width="0.7" opacity="0.45" stroke-dasharray="2 2">
        <path d="M24 70 L 33 41 M24 70 L 33 99 M176 70 L 167 41 M176 70 L 167 99" />
        <path d="M60 24 L 95 22 M140 24 L 105 22 M60 116 L 95 118 M140 116 L 105 118" />
      </g>
      {/* Labels on the hub */}
      <g font-family="ui-monospace, monospace" font-size="5" fill="currentColor" stroke="none" opacity="0.55">
        <text x="100" y="71" text-anchor="middle">COP</text>
      </g>
      <g font-family="ui-monospace, monospace" font-size="4.5" fill="currentColor" stroke="none" opacity="0.4">
        <text x="40" y="32">domain A</text>
        <text x="160" y="32" text-anchor="end">domain B</text>
        <text x="40" y="113">domain C</text>
        <text x="160" y="113" text-anchor="end">domain D</text>
        <text x="100" y="14" text-anchor="middle">sensor</text>
        <text x="100" y="129" text-anchor="middle">analyst</text>
      </g>
    </svg>
  )
}
