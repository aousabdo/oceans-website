---
/**
 * TraceThread — an explanatory schematic of what ATLAS measures: the
 * threads from requirement to system to deployed device, and the seven
 * ways information is lost along them. Hand-built, not drawn from any
 * dataset (the caption says so).
 */
type Dim = "attrition" | "ownership" | "realization" | "integration" | "evidence" | "orphaned" | "questions";

const DIMS: { key: Dim; label: string; text: string }[] = [
  { key: "attrition", label: "Requirement attrition", text: "A requirement from the original baseline that never reaches a system in today's architecture." },
  { key: "ownership", label: "Ownership ambiguity", text: "A system whose owning organization is assumed by a rule rather than stated in the source." },
  { key: "realization", label: "Realization gap", text: "A system that exists on paper with no hardware behind it at any site." },
  { key: "integration", label: "Integration gap", text: "An interface the architecture calls for with no current link behind it." },
  { key: "evidence", label: "Evidence gap", text: "A link inferred from role and context rather than read from an authoritative source." },
  { key: "orphaned", label: "Orphaned hardware", text: "A device on a site network that no system in the matrix accounts for." },
  { key: "questions", label: "Open questions", text: "Mapping questions the team has logged and not yet answered." },
];

const OFF = 34; // header band
const reqs = ["Detect", "Track", "Identify", "Alert", "Mitigate", "Record", "Share"].map((label, i) => ({
  id: `R${i + 1}`, label: `REQ-0${i + 1}  ${label}`, y: OFF + 30 + i * 60,
}));
const sysNames = ["Radar net", "RF detect", "EO/IR", "Track fusion", "C2 display", "Alert relay", "Effector", "Data archive", "Partner feed"];
const systems = sysNames.map((label, i) => ({
  id: "ABCDEFGHI"[i]!, label: `SYS-${"ABCDEFGHI"[i]}  ${label}`, y: OFF + 22 + i * 47.5,
}));
const devNames = ["radar-01", "rf-02", "cam-03", "srv-04", "ws-05", "relay-06", "cam-07", "jam-08", "sw-09", "ap-10"];
const devices = devNames.map((label, i) => ({
  id: `D${i + 1}`, label, y: OFF + (i < 6 ? 46 + i * 36 : 46 + 6 * 36 + 44 + (i - 6) * 36),
}));

const X = { rq: 18, rqW: 158, sy: 372, syW: 182, dv: 772, dvW: 136 };
const yOf = (id: string) =>
  (reqs.find((r) => r.id === id) ?? systems.find((s) => s.id === id) ?? devices.find((d) => d.id === id))!.y;

const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const mx = (x1 + x2) / 2;
  return `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`;
};

const rs: [string, string][] = [["R1", "A"], ["R1", "B"], ["R1", "C"], ["R2", "D"], ["R3", "C"], ["R4", "F"], ["R4", "E"], ["R5", "G"], ["R7", "I"], ["R7", "H"]];
const sd: { s: string; d: string; dims?: Dim[]; q?: boolean }[] = [
  { s: "A", d: "D1" }, { s: "B", d: "D2" }, { s: "C", d: "D3", q: true, dims: ["questions"] }, { s: "C", d: "D7" },
  { s: "D", d: "D4", dims: ["evidence"] }, { s: "E", d: "D5" }, { s: "F", d: "D6" },
  { s: "I", d: "D9", dims: ["evidence", "questions"], q: true },
];
const ownershipAmbiguous = new Set(["C", "H"]);
const unrealized = new Set(["G", "H"]);
const orphaned = new Set(["D8", "D10"]);
const integration: [string, string][] = [["A", "D"], ["D", "F"]];

let delay = 0;
const next = () => (delay += 0.06).toFixed(2);
const siteA = { y: OFF + 18, h: 6 * 36 + 14 };
const siteB = { y: OFF + 46 + 6 * 36 + 16, h: 4 * 36 + 14 };
---
<div class="tt" data-trace>
  <div class="overflow-x-auto pb-2 [-webkit-overflow-scrolling:touch]">
    <svg viewBox="0 0 930 486" class="tt-svg min-w-[720px] w-full" role="img" aria-labelledby="tt-title tt-desc">
      <title id="tt-title">Schematic of requirement-to-hardware traceability</title>
      <desc id="tt-desc">Seven requirements thread through nine systems to ten devices at two sites. Highlighted breaks show the seven lossiness dimensions ATLAS measures.</desc>

      {/* column headers */}
      <g class="font-mono" font-size="10" letter-spacing="2" fill="#4A6480">
        <text x={X.rq} y="14">INTENT · REQUIREMENTS</text>
        <text x={X.sy} y="14">ARCHITECTURE · SYSTEMS</text>
        <text x={X.dv - 18} y="14">DEPLOYED · DEVICES</text>
      </g>
      <line x1="0" x2="930" y1="24" y2="24" stroke="#0B1F3A" stroke-opacity="0.12" />

      {/* sites */}
      <g class="tt-el">
        <rect x={X.dv - 18} y={siteA.y} width={X.dvW + 36} height={siteA.h} rx="10" fill="#0B1F3A" fill-opacity="0.035" stroke="#0B1F3A" stroke-opacity="0.15" />
        <text x={X.dv - 8} y={siteA.y + 14} class="font-mono" font-size="9" letter-spacing="2" fill="#4A6480">SITE A</text>
        <rect x={X.dv - 18} y={siteB.y} width={X.dvW + 36} height={siteB.h} rx="10" fill="#0B1F3A" fill-opacity="0.035" stroke="#0B1F3A" stroke-opacity="0.15" />
        <text x={X.dv - 8} y={siteB.y + 14} class="font-mono" font-size="9" letter-spacing="2" fill="#4A6480">SITE B</text>
      </g>

      {/* requirement → system threads */}
      {rs.map(([r, s]) => (
        <path class="tt-el tt-draw" d={curve(X.rq + X.rqW, yOf(r), X.sy, yOf(s))} pathLength="1" fill="none" stroke="#1A6FAB" stroke-opacity="0.55" stroke-width="1.4" style={`--d:${next()}s`} />
      ))}

      {/* system → device threads */}
      {sd.map((e) => (
        <path
          class:list={["tt-el", e.dims?.includes("evidence") ? "tt-fade" : "tt-draw"]}
          data-dim={e.dims?.join(" ")}
          d={curve(X.sy + X.syW, yOf(e.s), X.dv, yOf(e.d))}
          pathLength="1"
          fill="none"
          stroke={e.dims?.includes("evidence") ? "#8C6A2C" : "#1A6FAB"}
          stroke-opacity="0.7"
          stroke-width="1.4"
          stroke-dasharray={e.dims?.includes("evidence") ? "0.006 0.012" : undefined}
          stroke-linecap="round"
          style={`--d:${(Number(next()) + 0.4).toFixed(2)}s`}
        />
      ))}

      {/* integration gaps — interfaces called for, not built */}
      {integration.map(([a, b]) => {
        const x = X.sy + X.syW;
        const y1 = yOf(a), y2 = yOf(b);
        return (
          <g class="tt-el tt-fade" data-dim="integration" style={`--d:${(Number(next()) + 0.6).toFixed(2)}s`}>
            <path d={`M ${x} ${y1} C ${x + 70} ${y1}, ${x + 70} ${y2}, ${x} ${y2}`} fill="none" stroke="#A12727" stroke-width="1.4" stroke-dasharray="4 4" />
            <text x={x + 57} y={(y1 + y2) / 2 + 13} class="font-mono" font-size="9" fill="#A12727" paint-order="stroke" stroke="#F7F5F0" stroke-width="4">no link</text>
          </g>
        );
      })}

      {/* open-question badges */}
      {sd.filter((e) => e.q).map((e) => {
        const x = (X.sy + X.syW + X.dv) / 2, y = (yOf(e.s) + yOf(e.d)) / 2;
        return (
          <g class="tt-el tt-fade" data-dim="questions" style={`--d:${(Number(next()) + 0.6).toFixed(2)}s`}>
            <circle cx={x} cy={y} r="9" fill="#F1EDE2" stroke="#8C6A2C" stroke-width="1.4" />
            <text x={x} y={y + 3.5} text-anchor="middle" font-size="11" font-weight="600" fill="#8C6A2C">?</text>
          </g>
        );
      })}

      {/* requirements */}
      {reqs.map((r) => {
        const lost = r.id === "R6";
        return (
          <g class="tt-el" data-dim={lost ? "attrition" : undefined}>
            <rect x={X.rq} y={r.y - 14} width={X.rqW} height="28" rx="6" fill={lost ? "#F1EDE2" : "#FFFFFF"} stroke={lost ? "#A12727" : "#0B1F3A"} stroke-opacity={lost ? 0.9 : 0.18} stroke-dasharray={lost ? "3 3" : undefined} />
            <text x={X.rq + 12} y={r.y + 4} class="font-mono" font-size="11" fill={lost ? "#A12727" : "#0B1F3A"}>{r.label}</text>
            {lost && (
              <g class="tt-fade" style="--d:1.4s">
                <path d={`M ${X.rq + X.rqW} ${r.y} L ${X.rq + X.rqW + 70} ${r.y}`} stroke="#A12727" stroke-width="1.4" stroke-dasharray="2 4" />
                <path d={`M ${X.rq + X.rqW + 72} ${r.y - 5} l 10 10 m 0 -10 l -10 10`} stroke="#A12727" stroke-width="1.6" />
                <text x={X.rq + X.rqW + 90} y={r.y + 3.5} class="font-mono" font-size="9" fill="#A12727">not carried forward</text>
              </g>
            )}
          </g>
        );
      })}

      {/* systems */}
      {systems.map((s) => {
        const amb = ownershipAmbiguous.has(s.id);
        const unreal = unrealized.has(s.id);
        const dims = [amb && "ownership", unreal && "realization"].filter(Boolean).join(" ");
        return (
          <g class="tt-el" data-dim={dims || undefined}>
            <rect x={X.sy} y={s.y - 14} width={X.syW} height="28" rx="6" fill="#FFFFFF" stroke={amb ? "#8C6A2C" : "#0B1F3A"} stroke-opacity={amb ? 0.95 : 0.18} stroke-dasharray={amb ? "4 3" : undefined} />
            <text x={X.sy + 12} y={s.y + 4} class="font-mono" font-size="11" fill="#0B1F3A">{s.label}</text>
            {amb && <text x={X.sy + X.syW - 8} y={s.y - 18} text-anchor="end" class="font-mono" font-size="9" fill="#8C6A2C">owner?</text>}
            {unreal && (
              <g class="tt-fade" style="--d:1.6s">
                <path d={`M ${X.sy + X.syW} ${s.y} L ${X.sy + X.syW + 46} ${s.y}`} stroke="#A12727" stroke-width="1.4" stroke-dasharray="2 4" />
                <path d={`M ${X.sy + X.syW + 48} ${s.y - 5} l 10 10 m 0 -10 l -10 10`} stroke="#A12727" stroke-width="1.6" />
                <text x={X.sy + X.syW + 64} y={s.y + 3.5} class="font-mono" font-size="9" fill="#A12727">no hardware</text>
              </g>
            )}
          </g>
        );
      })}

      {/* devices */}
      {devices.map((d) => {
        const orphan = orphaned.has(d.id);
        return (
          <g class="tt-el" data-dim={orphan ? "orphaned" : undefined}>
            <rect x={X.dv} y={d.y - 12} width={X.dvW} height="24" rx="12" fill={orphan ? "#F1EDE2" : "#0B1F3A"} stroke={orphan ? "#A12727" : "#0B1F3A"} stroke-dasharray={orphan ? "3 3" : undefined} />
            <text x={X.dv + 14} y={d.y + 4} class="font-mono" font-size="10.5" fill={orphan ? "#A12727" : "#EBE3D0"}>{d.label}</text>
            {orphan && <text x={X.dv + X.dvW - 10} y={d.y + 4} text-anchor="end" class="font-mono" font-size="9" fill="#A12727">unclaimed</text>}
          </g>
        );
      })}
    </svg>
  </div>

  <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.18em] text-[#4A6480] sm:hidden" aria-hidden="true">Swipe to follow the thread →</p>
  <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Lossiness dimensions">
    {DIMS.map((d, i) => (
      <button
        type="button"
        class="tt-chip rounded-full border border-[#0B1F3A]/15 bg-white/70 px-3.5 py-1.5 font-mono text-[11px] tracking-wide text-[#0B1F3A] transition-colors"
        aria-pressed="false"
        data-key={d.key}
        data-text={d.text}
      >
        <span class="mr-1.5 text-[#8C6A2C]">{String(i + 1).padStart(2, "0")}</span>{d.label}
      </button>
    ))}
  </div>
  <p class="tt-readout mt-4 min-h-[3rem] max-w-2xl font-serif text-lg italic leading-relaxed text-[#0A2942]" aria-live="polite">
    Seven measures of what falls out between the requirement, the system and the hardware. Pick one to see where it bites.
  </p>
  <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.18em] text-[#4A6480]">Schematic · illustrative, not drawn from any dataset</p>
</div>

<style>
  .tt-svg .tt-el { transition: opacity 0.35s ease; }
  .tt[data-focus] .tt-svg .tt-el { opacity: 0.12; }
  .tt[data-focus="attrition"] .tt-svg .tt-el[data-dim~="attrition"],
  .tt[data-focus="ownership"] .tt-svg .tt-el[data-dim~="ownership"],
  .tt[data-focus="realization"] .tt-svg .tt-el[data-dim~="realization"],
  .tt[data-focus="integration"] .tt-svg .tt-el[data-dim~="integration"],
  .tt[data-focus="evidence"] .tt-svg .tt-el[data-dim~="evidence"],
  .tt[data-focus="orphaned"] .tt-svg .tt-el[data-dim~="orphaned"],
  .tt[data-focus="questions"] .tt-svg .tt-el[data-dim~="questions"] { opacity: 1; }
  .tt-chip:hover { border-color: rgba(11, 31, 58, 0.45); }
  .tt-chip[aria-pressed="true"] { background: #0B1F3A; color: #F1EDE2; border-color: #0B1F3A; }
  .tt-chip[aria-pressed="true"] span { color: #D4A24A; }

  @media (prefers-reduced-motion: no-preference) {
    .tt-draw { stroke-dasharray: 1; stroke-dashoffset: 1; }
    .tt-fade { opacity: 0; }
    .tt.is-in .tt-draw { stroke-dashoffset: 0; transition: stroke-dashoffset 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s); }
    .tt.is-in .tt-fade { opacity: 1; transition: opacity 0.6s ease var(--d, 0s); }
    /* once the intro has played, focus changes respond immediately */
    .tt.is-settled .tt-svg .tt-el, .tt.is-settled .tt-svg .tt-fade { transition: opacity 0.35s ease; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-trace]").forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>(".tt-chip")];
    const readout = root.querySelector<HTMLElement>(".tt-readout")!;
    const resting = readout.textContent ?? "";
    let pinned: string | null = null;

    const apply = (key: string | null) => {
      if (key) root.dataset.focus = key;
      else delete root.dataset.focus;
      const chip = chips.find((c) => c.dataset.key === key);
      readout.textContent = chip ? chip.dataset.text ?? "" : resting;
    };

    chips.forEach((c) => {
      c.addEventListener("click", () => {
        pinned = pinned === c.dataset.key ? null : c.dataset.key ?? null;
        chips.forEach((o) => o.setAttribute("aria-pressed", String(o.dataset.key === pinned)));
        apply(pinned);
      });
      c.addEventListener("pointerenter", () => apply(c.dataset.key ?? null));
      c.addEventListener("pointerleave", () => apply(pinned));
      c.addEventListener("focus", () => apply(c.dataset.key ?? null));
      c.addEventListener("blur", () => apply(pinned));
    });

    new IntersectionObserver(([e], obs) => {
      if (e?.isIntersecting) {
        root.classList.add("is-in");
        obs.disconnect();
        window.setTimeout(() => root.classList.add("is-settled"), 2600);
      }
    }, { threshold: 0.25 }).observe(root);
  });
</script>
