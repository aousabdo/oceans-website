---
/**
 * NewsletterSignup — slim email-capture form for the Journal mailing list.
 *
 * Variants:
 *  - "inline" (default): single-row layout, suits footer + sidebars
 *  - "card": padded panel with headline + description, suits /blog top
 *
 * Submits to /api/subscribe (Pages Function). Inline progressive
 * enhancement: with JS off, posts normally; with JS on, shows
 * inline success/error feedback without a page reload.
 */
interface Props {
  variant?: "inline" | "card";
  source?: string;
  class?: string;
}
const { variant = "inline", source = "footer", class: extra = "" } = Astro.props as Props;
---
{variant === "card" ? (
  <section class:list={["bg-surface border border-border-hairline rounded-lg p-6 md:p-8", extra]} data-newsletter-root>
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">▌ The Journal</div>
    <h3 class="font-display text-xl md:text-2xl font-bold text-fg-strong mt-2 leading-tight">
      Practitioner notes, twice a month.
    </h3>
    <p class="mt-3 text-muted leading-relaxed max-w-2xl">
      Field-tested writing on T&E, mission data, requirements, and the
      messy parts of federal engineering. No fluff, no funnels. Unsubscribe
      one click.
    </p>
    <form
      method="POST"
      action="/api/subscribe"
      class="mt-6 flex flex-col sm:flex-row gap-3 max-w-xl"
      data-newsletter-form
      novalidate
    >
      <input type="hidden" name="source" value={source} />
      <label class="flex-1 min-w-0">
        <span class="sr-only">Email address</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@agency.gov"
          class="w-full bg-bg border border-border-hairline rounded-md px-4 py-2.5 text-fg placeholder:text-muted focus:outline-none focus:border-accent transition-colors"
          aria-label="Email address"
        />
      </label>
      <button
        type="submit"
        class="font-mono text-[10px] uppercase tracking-widest bg-accent text-bg px-5 py-2.5 rounded-md hover:brightness-110 transition-all whitespace-nowrap"
      >
        Subscribe
      </button>
    </form>
    <p class="mt-3 text-[11px] text-muted" data-newsletter-status aria-live="polite">
      No spam. Two-business-day response policy on replies.
    </p>
  </section>
) : (
  <div class:list={["w-full", extra]} data-newsletter-root>
    <form
      method="POST"
      action="/api/subscribe"
      class="flex flex-col sm:flex-row gap-2"
      data-newsletter-form
      novalidate
    >
      <input type="hidden" name="source" value={source} />
      <label class="flex-1 min-w-0">
        <span class="sr-only">Email address for the Journal</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@agency.gov"
          class="w-full bg-bg border border-border-hairline rounded-md px-3 py-2 text-sm text-fg placeholder:text-muted focus:outline-none focus:border-accent transition-colors"
          aria-label="Email address"
        />
      </label>
      <button
        type="submit"
        class="font-mono text-[10px] uppercase tracking-widest bg-accent text-bg px-4 py-2 rounded-md hover:brightness-110 transition-all whitespace-nowrap"
      >
        Subscribe
      </button>
    </form>
    <p class="mt-2 text-[10px] text-muted" data-newsletter-status aria-live="polite">
      Journal updates. Unsubscribe one click.
    </p>
  </div>
)}

<script is:inline>
  (function () {
    document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
      const root = form.closest("[data-newsletter-root]");
      const status = root?.querySelector("[data-newsletter-status]");
      const button = form.querySelector('button[type="submit"]');
      const input = form.querySelector('input[name="email"]');

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!input || !button || !status) return;
        const email = input.value.trim();
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          status.textContent = "Please enter a valid email.";
          status.classList.remove("text-muted", "text-accent");
          status.classList.add("text-[color:var(--color-accent-critical)]");
          input.focus();
          return;
        }

        button.disabled = true;
        const originalLabel = button.textContent;
        button.textContent = "Sending…";
        status.textContent = "";

        try {
          const fd = new FormData(form);
          const r = await fetch(form.action, { method: "POST", body: fd });
          if (r.ok) {
            status.textContent = "You're in. We'll be in touch.";
            status.classList.remove("text-muted", "text-[color:var(--color-accent-critical)]");
            status.classList.add("text-accent");
            input.value = "";
          } else {
            const j = await r.json().catch(() => ({}));
            status.textContent = j.error === "invalid_email" ? "That email looked off — try again?" : "Something hiccuped. Try again in a minute.";
            status.classList.remove("text-muted", "text-accent");
            status.classList.add("text-[color:var(--color-accent-critical)]");
          }
        } catch {
          status.textContent = "Network error. Try again in a minute.";
        } finally {
          button.disabled = false;
          button.textContent = originalLabel ?? "Subscribe";
        }
      });
    });
  })();
</script>
