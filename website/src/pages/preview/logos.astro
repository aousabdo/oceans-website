---
import BaseLayout from "@layouts/BaseLayout.astro";

// SVG renderers — return the raw markup for each concept at requested size.
function mark1(size = 72) {
  const id = `m1-${Math.random().toString(36).slice(2, 8)}`;
  return `<svg viewBox="0 0 100 100" width="${size}" height="${size}">
    <defs><clipPath id="${id}"><circle cx="50" cy="50" r="38"/></clipPath></defs>
    <circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="3"/>
    <g clip-path="url(#${id})"><path d="M 5 52 Q 22 42 38 52 T 70 52 T 102 52" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></g>
  </svg>`;
}
function mark2(size = 72) {
  return `<svg viewBox="0 0 120 70" width="${size * 1.4}" height="${size * 0.8}">
    <path d="M 8 16 Q 26 6 44 16 T 80 16 T 112 16" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
    <path d="M 8 35 Q 26 25 44 35 T 80 35 T 112 35" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" opacity="0.65"/>
    <path d="M 8 54 Q 26 44 44 54 T 80 54 T 112 54" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" opacity="0.35"/>
  </svg>`;
}
function mark3(size = 72) {
  return `<svg viewBox="0 0 120 60" width="${size * 1.5}" height="${size * 0.7}">
    <path d="M 22 8 L 12 8 L 12 52 L 22 52" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="miter"/>
    <path d="M 98 8 L 108 8 L 108 52 L 98 52" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="miter"/>
    <path d="M 28 30 Q 42 18 60 30 T 92 30" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
  </svg>`;
}
function mark4() {
  return `<div style="display:flex;flex-direction:column;align-items:center;gap:8px;">
    <span style="font-family:'Syne',sans-serif;font-weight:700;letter-spacing:0.18em;font-size:28px;color:currentColor;">OCEANS</span>
    <svg viewBox="0 0 160 18" width="150" height="17">
      <path d="M 4 9 Q 20 -1 36 9 T 68 9 T 100 9 T 132 9 T 156 9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  </div>`;
}
function mark5() {
  const id = `m5-${Math.random().toString(36).slice(2, 8)}`;
  return `<div style="display:flex;align-items:center;gap:10px;">
    <svg viewBox="0 0 100 100" width="48" height="48">
      <defs><clipPath id="${id}"><circle cx="50" cy="50" r="38"/></clipPath></defs>
      <circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="6"/>
      <g clip-path="url(#${id})"><path d="M 5 52 Q 22 42 38 52 T 70 52 T 102 52" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/></g>
    </svg>
    <span style="font-family:'Syne',sans-serif;font-weight:700;letter-spacing:0.16em;font-size:32px;color:currentColor;">CEANS</span>
  </div>`;
}

const renderers: Record<string, (size?: number) => string> = {
  c1: mark1, c2: mark2, c3: mark3,
  c4: () => mark4(),
  c5: () => mark5(),
};

function lockup(id: string) {
  if (id === "c4") return mark4();
  if (id === "c5") return mark5();
  const mk = renderers[id]!(40);
  return `<div style="display:inline-flex;align-items:center;gap:12px;color:currentColor;">
    ${mk}
    <span style="font-family:'Syne',sans-serif;font-weight:700;letter-spacing:0.18em;font-size:24px;">OCEANS</span>
  </div>`;
}
function favicon(id: string) {
  const size = 24;
  if (id === "c4") {
    return `<svg viewBox="0 0 160 18" width="60" height="7"><path d="M 4 9 Q 20 -1 36 9 T 68 9 T 100 9 T 132 9 T 156 9" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round"/></svg>`;
  }
  return renderers[id]!(size);
}

const concepts = [
  { id: "c1", n: "01", name: "Horizon-O",
    rationale: "A perfect ring containing a single wave — combines a horizon line and a wave inside one form. Reads as 'O for OCEANS' plus ocean plus horizon at once. Holds together at favicon size." },
  { id: "c2", n: "02", name: "Soundings",
    rationale: "Three stacked wave lines decreasing in opacity — depth soundings, sonar returns, signal layers. Suggests measurement plus ocean. Quiet, almost typographic." },
  { id: "c3", n: "03", name: "Bracketed",
    rationale: "Square brackets enclosing a single wave — scientific notation meets ocean. Reads as engineering rigor (the brackets) plus maritime (the wave). Geometric, modern." },
  { id: "c4", n: "04", name: "One Stroke",
    rationale: "A single sweeping continuous wave under the wordmark. The most minimal of the bunch — no separate mark, the wave is part of the wordmark. Most editorial. Risks being forgettable as a standalone icon." },
  { id: "c5", n: "05", name: "Special-O",
    rationale: "The 'O' in 'OCEANS' becomes a stylized wave-ring (like Concept 01 but embedded in the wordmark). Mark and wordmark are one inseparable thing. Versatile — the special O works alone as an icon, or stays in the wordmark as a logotype.",
    recommended: true },
];
---
<BaseLayout title="Logo Concepts — Review" description="Five logo concepts for OCEANS LLC, shown across the three theme directions.">
  <main class="mx-auto max-w-5xl px-6 py-16 md:py-20">
    <header class="mb-12">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent">For Danny · Logo Review</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-fg-strong mt-4 leading-tight">
        Five logo concepts for OCEANS LLC.
      </h1>
      <p class="mt-6 text-fg max-w-2xl leading-relaxed">
        Simple, powerful, monochrome-safe. Each concept is rendered against all three theme
        backgrounds so you can see how it would feel on each direction. Lockups and favicon-size
        proofs below each. Reply with the concept number (1–5) you like best — or ask for a tweak.
      </p>
    </header>

    {
      concepts.map((c) => (
        <article class="mb-12 border border-border-hairline rounded-xl overflow-hidden">
          <div class="p-6 md:p-8">
            <div class="flex items-baseline justify-between gap-4 mb-2">
              <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">CONCEPT {c.n}</p>
              {c.recommended && (
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-go">★ my pick</p>
              )}
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-fg-strong leading-tight">{c.name}</h2>
            <p class="mt-3 text-muted leading-relaxed max-w-2xl">{c.rationale}</p>
          </div>

          <div class="grid grid-cols-3 gap-px bg-border-hairline">
            <div class="aspect-[4/3] flex flex-col items-center justify-center gap-3 p-4" style="background:#1A2840;color:#5BD4FF;">
              <div set:html={renderers[c.id]!()} />
              <span class="font-mono text-[9px] uppercase tracking-widest opacity-60">Operator</span>
            </div>
            <div class="aspect-[4/3] flex flex-col items-center justify-center gap-3 p-4" style="background:#F4F1EC;color:#1A4477;">
              <div set:html={renderers[c.id]!()} />
              <span class="font-mono text-[9px] uppercase tracking-widest opacity-60">Institute</span>
            </div>
            <div class="aspect-[4/3] flex flex-col items-center justify-center gap-3 p-4" style="background:linear-gradient(180deg,#EEF5FA,#F4F9FC);color:#1A6FAB;">
              <div set:html={renderers[c.id]!()} />
              <span class="font-mono text-[9px] uppercase tracking-widest opacity-60">Mariner</span>
            </div>
          </div>

          <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-border-hairline">
            <div>
              <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted mb-3">Lockup</p>
              <div set:html={lockup(c.id)} />
            </div>
            <div>
              <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted mb-3">Favicon (24px)</p>
              <div set:html={favicon(c.id)} />
            </div>
          </div>
        </article>
      ))
    }

    <section class="mt-16 p-8 border border-accent/30 rounded-xl bg-surface">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent">Also review the three theme directions</p>
      <ul class="mt-4 space-y-2 text-fg">
        <li>
          <strong class="text-fg-strong">Operator</strong> — defense-tech mission console:
          <a href="https://theme-operator.oceans-website.pages.dev" class="text-accent underline ml-1">
            theme-operator.oceans-website.pages.dev
          </a>
        </li>
        <li>
          <strong class="text-fg-strong">Institute</strong> — editorial / scientific:
          <a href="https://theme-institute.oceans-website.pages.dev" class="text-accent underline ml-1">
            theme-institute.oceans-website.pages.dev
          </a>
        </li>
        <li>
          <strong class="text-fg-strong">Mariner</strong> — cinematic / brand-led:
          <a href="https://theme-mariner.oceans-website.pages.dev" class="text-accent underline ml-1">
            theme-mariner.oceans-website.pages.dev
          </a>
        </li>
      </ul>
      <p class="mt-6 text-sm text-muted leading-relaxed">
        Reply with: (a) your favorite theme by name, and (b) which logo concept (1–5) works for you.
        Quick reactions are fine. — Aous
      </p>
    </section>
  </main>
</BaseLayout>
