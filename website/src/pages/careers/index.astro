---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Eyebrow from "@components/Eyebrow.astro";
import RoleCard from "@components/RoleCard.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import { getCollection } from "astro:content";

const open = (await getCollection("jobs"))
  .filter((j) => j.data.open)
  .sort((a, b) => +b.data.posted - +a.data.posted);

const principles = [
  {
    title: "Rigor over speed",
    desc: "We don't ship reports that won't survive review. Every recommendation is traceable.",
  },
  {
    title: "Quantitative over qualitative",
    desc: "Structured test design and statistical methods — not assertions dressed as evidence.",
  },
  {
    title: "Outcomes over outputs",
    desc: "We own the result. Decision-grade reporting that actually informs the decision.",
  },
  {
    title: "Independent over agreeable",
    desc: "Evaluation independent enough to be inconvenient when the data demands it.",
  },
];

const expectations = [
  {
    step: "01",
    title: "Initial conversation",
    desc: "30 minutes by phone or video. We talk about your background, the kind of work you want to do, and the kind of work we have.",
  },
  {
    step: "02",
    title: "Technical depth",
    desc: "A working session on a real problem from one of our domains — systems engineering, T&E, or mission data. Not a whiteboard puzzle.",
  },
  {
    step: "03",
    title: "Team alignment",
    desc: "Meet the leaders you'd work with. We talk about how engagements run, how decisions get made, and what we expect from each other.",
  },
  {
    step: "04",
    title: "Decision",
    desc: "Offer and onboarding, or a candid no. We respond fast. You hear back within a week of every step.",
  },
];
---
<PageLayout title="Careers" description="Open roles at OCEANS LLC — engineers who care about defensible work.">
  <!-- HERO -->
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-12">
    <Eyebrow>Careers</Eyebrow>
    <h1 class="font-display text-5xl md:text-7xl font-bold text-fg-strong mt-4 leading-[1.05]">
      Build rigorous engineering<br />with us.
    </h1>
    <p class="mt-8 text-lg md:text-xl text-muted leading-relaxed max-w-3xl">
      We hire engineers who care about defensible work — not just clever solutions. If you want to
      do rigorous, traceable, decision-grade engineering for federal missions, we'd like to talk.
    </p>
  </section>

  <!-- HOW WE WORK -->
  <section class="bg-bg-2 border-y border-border-hairline">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <SectionLabel>How we work</SectionLabel>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
        The principles we hire against.
      </h2>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          principles.map((p) => (
            <Card>
              <h3 class="font-display text-lg font-bold text-fg-strong leading-snug">{p.title}</h3>
              <p class="mt-3 text-sm text-muted leading-relaxed">{p.desc}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- OPEN ROLES -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="flex items-end justify-between gap-8 flex-wrap mb-10">
      <div>
        <SectionLabel>Open roles</SectionLabel>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
          {open.length} {open.length === 1 ? "position" : "positions"} open right now.
        </h2>
      </div>
      <Button href="mailto:careers@oceansllc.com" variant="outline" size="sm">
        Don't see a fit? Email us
      </Button>
    </div>

    {
      open.length === 0 ? (
        <p class="text-muted">No open roles right now — a general application is always welcome.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {open.map((j) => (
            <RoleCard
              title={j.data.title}
              location={j.data.location}
              level={j.data.level}
              type={j.data.type}
              href={`/careers/${j.data.slug}`}
            />
          ))}
        </div>
      )
    }
  </section>

  <!-- WHAT TO EXPECT -->
  <section class="bg-bg-2 border-y border-border-hairline">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <SectionLabel>What to expect</SectionLabel>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
        Our hiring process.
      </h2>
      <p class="mt-3 text-muted max-w-2xl leading-relaxed">
        Designed to be fast and respectful of your time. You hear back within a week of every step
        — yes, no, or what's next.
      </p>
      <ol class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          expectations.map((e) => (
            <li class="bg-surface border border-border-hairline rounded-lg p-6 flex gap-5">
              <span class="font-display text-3xl font-bold text-accent leading-none shrink-0">
                {e.step}
              </span>
              <div>
                <h3 class="font-display text-lg font-bold text-fg-strong leading-snug">{e.title}</h3>
                <p class="mt-2 text-sm text-muted leading-relaxed">{e.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- GENERAL APPLICATION -->
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <SectionLabel class="justify-center">General application</SectionLabel>
    <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
      No fit listed?
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-xl mx-auto">
      Send us a resume and a short note about the kind of work you want to do. We read every one
      and reply within two business days.
    </p>
    <div class="mt-8 flex justify-center gap-3 flex-wrap">
      <Button href="mailto:careers@oceansllc.com" variant="primary">
        Email careers@oceansllc.com
      </Button>
      <Button href="/about" variant="outline" size="sm">Learn about OCEANS</Button>
    </div>
  </section>
</PageLayout>
