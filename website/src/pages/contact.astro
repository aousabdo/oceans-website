---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Button from "@components/Button.astro";
import Form from "@components/Form.astro";
import FormField from "@components/FormField.astro";
import Turnstile from "@components/Turnstile.astro";
---
<PageLayout title="Contact" description="Reach OCEANS LLC for federal systems engineering, test & evaluation, and mission data engagements. Use the form below — we reply within two business days.">
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-12">
    <SectionLabel>Contact</SectionLabel>
    <h1 class="font-display text-5xl md:text-6xl font-bold text-fg-strong mt-4 leading-tight">
      Start a conversation.
    </h1>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24 grid grid-cols-1 md:grid-cols-5 gap-12">
    <aside class="md:col-span-2 space-y-8">
      <div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-accent">Address</div>
        <address class="not-italic mt-3 text-fg leading-relaxed">
          Jacksonville, FL<br />
          <a
            href="https://www.linkedin.com/company/o.c.e.a.n.s.-llc"
            class="text-accent"
            target="_blank"
            rel="noopener"
          >
            LinkedIn ↗
          </a>
        </address>
      </div>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-accent">For careers</div>
        <p class="mt-3 text-fg leading-relaxed">
          See <a href="/careers" class="text-accent">open roles</a> and apply through the role page.
        </p>
      </div>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-accent">Federal</div>
        <ul class="mt-3 text-sm text-muted leading-relaxed font-mono space-y-0.5">
          <li>NAICS: <span class="text-fg">541330 · 541715 · 541512</span></li>
          <li>SAM.gov: <span class="text-fg">Active registration</span></li>
          <li>CAGE / UEI: <span class="text-fg">On request via form</span></li>
        </ul>
      </div>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-accent">Response time</div>
        <p class="mt-3 text-sm text-muted leading-relaxed">
          We read every inquiry and reply within two business days.
        </p>
      </div>
    </aside>

    <div class="md:col-span-3">
      <div class="bg-surface border border-border-hairline rounded-lg p-8 md:p-10">
        <SectionLabel>Write to us</SectionLabel>
        <p class="mt-4 text-fg leading-relaxed">
          Fill in the form below — we route every submission to the right person internally and
          reply within two business days.
        </p>

        <Form action="/api/contact" class="mt-8 max-w-none">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <FormField name="firstName" label="First name" required autocomplete="given-name" />
            <FormField name="lastName" label="Last name" required autocomplete="family-name" />
          </div>
          <FormField name="email" label="Email" type="email" required autocomplete="email" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <FormField name="phone" label="Phone (optional)" type="tel" autocomplete="tel" />
            <FormField
              name="organization"
              label="Organization (optional)"
              autocomplete="organization"
            />
          </div>
          <FormField
            name="subject"
            label="Subject (e.g. T&E, Architecture, RFI)"
            placeholder="Inquiry"
          />
          <FormField
            name="message"
            label="Message"
            type="textarea"
            required
            rows={6}
            placeholder="Tell us what you're working on…"
          />
          <Turnstile />
          <Button type="submit" variant="primary">Send message</Button>
        </Form>
      </div>
    </div>
  </section>

  <script is:inline>
    // Pre-fill subject + message from URL params (used by /scope Engagement Calculator)
    (function () {
      const params = new URLSearchParams(window.location.search);
      const subject = params.get("subject");
      const message = params.get("message");
      if (subject) {
        const el = document.querySelector('input[name="subject"], textarea[name="subject"]');
        if (el) el.value = subject;
      }
      if (message) {
        const el = document.querySelector('textarea[name="message"]');
        if (el) el.value = message;
      }
    })();
  </script>
</PageLayout>
