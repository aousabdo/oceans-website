---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Button from "@components/Button.astro";
---
<PageLayout title="Contact" description="Start a conversation with OCEANS LLC.">
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-12">
    <SectionLabel>Contact</SectionLabel>
    <h1 class="font-display text-5xl md:text-6xl font-bold text-fg-strong mt-4 leading-tight">
      Start a conversation.
    </h1>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24 grid grid-cols-1 md:grid-cols-5 gap-12">
    <aside class="md:col-span-2 space-y-8">
      <div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-accent">Address</div>
        <address class="not-italic mt-3 text-fg leading-relaxed">
          Jacksonville, FL 32099<br />
          <a href="mailto:info@oceansllc.com" class="text-accent">info@oceansllc.com</a><br />
          727-455-9383
        </address>
      </div>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-accent">For careers</div>
        <p class="mt-3 text-fg leading-relaxed">
          <a href="mailto:careers@oceansllc.com" class="text-accent">careers@oceansllc.com</a>
        </p>
      </div>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-accent">Federal</div>
        <ul class="mt-3 text-sm text-muted leading-relaxed font-mono space-y-0.5">
          <li>CAGE: <span class="text-fg">[TBD]</span></li>
          <li>NAICS: <span class="text-fg">541330 · 541715 · 541512</span></li>
          <li>UEI: <span class="text-fg">[TBD]</span></li>
        </ul>
      </div>
    </aside>

    <div class="md:col-span-3 bg-surface border border-border-hairline rounded-lg p-10">
      <SectionLabel>Email is best for now</SectionLabel>
      <p class="mt-6 text-fg leading-relaxed">
        We'll have an in-page contact form here once the backend lands. Until then, write to us
        directly — we read everything that comes into <a href="mailto:info@oceansllc.com" class="text-accent">info@oceansllc.com</a>
        and reply within two business days.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="mailto:info@oceansllc.com?subject=Engagement inquiry" variant="primary">
          Email info@oceansllc.com
        </Button>
        <Button href="/capabilities" variant="outline">View capabilities statement</Button>
      </div>
      <p class="mt-8 font-mono text-[10px] uppercase tracking-widest text-muted">
        ▌ inline form with anti-spam lands in M11
      </p>
    </div>
  </section>
</PageLayout>
