---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Button from "@components/Button.astro";
import MetricCallout from "@components/MetricCallout.astro";
import { getCollection } from "astro:content";

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
const founders = team.filter((t) => t.data.slug === "daniel-brent" || t.data.slug === "paul-morrisseau");
const directors = team.filter((t) => t.data.leadership && !founders.includes(t));
const engineers = team.filter((t) => !t.data.leadership);

function initials(name: string) {
  return name
    .split(" ")
    .map((p) => p.charAt(0))
    .join("")
    .slice(0, 2)
    .toUpperCase();
}
---
<PageLayout title="Team" description="Leadership and engineering at OCEANS LLC — co-founders, domain directors, and senior architects running federal mission programs.">
  <!-- HERO -->
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-12">
    <Eyebrow>The team</Eyebrow>
    <h1 class="font-display text-5xl md:text-7xl font-bold text-fg-strong mt-4 leading-[1.05]">
      The people behind<br />OCEANS.
    </h1>
    <p class="mt-8 text-lg md:text-xl text-muted leading-relaxed max-w-3xl">
      Co-founders with three decades of shared work, domain directors leading
      sector-specific engagements, and senior architects building the
      systems federal customers depend on.
    </p>
  </section>

  <!-- TEAM METRICS -->
  <section class="mx-auto max-w-5xl px-6 py-8">
    <MetricCallout
      metrics={[
        { label: "Co-Founders", value: String(founders.length) },
        { label: "Domain Directors", value: String(directors.length) },
        { label: "Senior Architects", value: String(engineers.length) },
        { label: "Designation", value: "SDVOSB" },
      ]}
    />
  </section>

  <!-- FOUNDERS — large cards -->
  <section class="bg-bg-2 border-y border-border-hairline">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <SectionLabel>Co-founders</SectionLabel>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
        Built on a thirty-year friendship.
      </h2>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          founders.map((m) => (
            <article class="group bg-surface border border-border-hairline rounded-xl overflow-hidden transition-all hover:border-accent/40 hover:shadow-lg">
              {m.data.portrait && (
                <div class="aspect-[4/3] bg-bg-2 overflow-hidden">
                  <img
                    src={m.data.portrait}
                    alt={m.data.name}
                    width="640"
                    height="480"
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <div class="p-7">
                <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">
                  {m.data.role}
                </div>
                <h3 class="font-display text-2xl md:text-3xl font-bold text-fg-strong mt-2 leading-snug">
                  {m.data.name}
                </h3>
                <p class="mt-4 text-fg leading-relaxed">{m.data.bio}</p>
                {m.data.email && (
                  <a
                    href={`mailto:${m.data.email}`}
                    class="mt-5 inline-block font-mono text-xs text-accent hover:underline"
                  >
                    {m.data.email}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- DIRECTORS — secondary -->
  {
    directors.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-20">
        <SectionLabel>Directors</SectionLabel>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
          Domain leadership.
        </h2>
        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
          {directors.map((m) => (
            <article class="group bg-surface border border-border-hairline rounded-xl p-7 flex gap-6 transition-all hover:border-accent/40">
              {m.data.portrait ? (
                <img
                  src={m.data.portrait}
                  alt={m.data.name}
                  width="140"
                  height="140"
                  loading="lazy"
                  class="w-28 h-28 md:w-32 md:h-32 object-cover rounded-full border border-border-hairline shrink-0"
                />
              ) : (
                <div
                  class="w-28 h-28 md:w-32 md:h-32 rounded-full border border-border-hairline bg-bg-2 grid place-items-center font-display text-3xl md:text-4xl font-bold text-accent shrink-0"
                  aria-hidden="true"
                >
                  {initials(m.data.name)}
                </div>
              )}
              <div class="min-w-0">
                <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">
                  {m.data.role}
                </div>
                <h3 class="font-display text-xl md:text-2xl font-bold text-fg-strong mt-2 leading-snug">
                  {m.data.name}
                </h3>
                <p class="mt-3 text-sm text-fg leading-relaxed">{m.data.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- ENGINEERS — non-leadership senior architects -->
  {
    engineers.length > 0 && (
      <section class="bg-bg-2 border-y border-border-hairline">
        <div class="mx-auto max-w-6xl px-6 py-20">
          <SectionLabel>Engineering</SectionLabel>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
            Senior architects.
          </h2>
          <p class="mt-3 text-muted max-w-2xl leading-relaxed">
            Building the systems federal customers depend on across DHS CBP, S&T, and adjacent missions.
          </p>
          <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
            {engineers.map((m) => (
              <article class="group bg-surface border border-border-hairline rounded-xl p-7 flex gap-6 transition-all hover:border-accent/40">
                {m.data.portrait ? (
                  <img
                    src={m.data.portrait}
                    alt={m.data.name}
                    width="140"
                    height="140"
                    loading="lazy"
                    class="w-28 h-28 md:w-32 md:h-32 object-cover rounded-full border border-border-hairline shrink-0"
                  />
                ) : (
                  <div
                    class="w-28 h-28 md:w-32 md:h-32 rounded-full border border-border-hairline bg-bg-2 grid place-items-center font-display text-3xl md:text-4xl font-bold text-accent shrink-0"
                    aria-hidden="true"
                  >
                    {initials(m.data.name)}
                  </div>
                )}
                <div class="min-w-0">
                  <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">
                    {m.data.role}
                  </div>
                  <h3 class="font-display text-xl md:text-2xl font-bold text-fg-strong mt-2 leading-snug">
                    {m.data.name}
                  </h3>
                  <p class="mt-3 text-sm text-fg leading-relaxed">{m.data.bio}</p>
                  {m.data.email && (
                    <a
                      href={`mailto:${m.data.email}`}
                      class="mt-3 inline-block font-mono text-xs text-accent hover:underline"
                    >
                      {m.data.email}
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- WE'RE HIRING -->
  <section class="bg-surface border-y border-border-hairline">
    <div class="mx-auto max-w-5xl px-6 py-16 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 items-center">
      <div>
        <SectionLabel>We're hiring</SectionLabel>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
          Engineers who care about defensible work.
        </h2>
        <p class="mt-4 text-muted leading-relaxed max-w-xl">
          If you want to do rigorous, traceable, decision-grade engineering for federal missions —
          we'd like to talk.
        </p>
      </div>
      <div class="flex flex-col gap-3 shrink-0">
        <Button href="/careers" variant="primary">See open roles</Button>
        <Button href="mailto:careers@oceansllc.com" variant="outline" size="sm">
          Email careers@
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
