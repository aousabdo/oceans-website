---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Badge from "@components/Badge.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import MetricCallout from "@components/MetricCallout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("caseStudies");
  const services = await getCollection("services");
  return items.map((c) => ({
    params: { slug: c.data.slug },
    props: {
      c: c.data,
      capabilities: services.filter((s) => c.data.capabilities.includes(s.data.slug)),
    },
  }));
}
const { c, capabilities } = Astro.props;
---
<PageLayout title={c.title} description={c.summary} type="article">
  <!-- HERO -->
  <section class="border-b border-border-hairline">
    <div class="mx-auto max-w-4xl px-6 pt-20 pb-12">
      <Eyebrow>{c.client} · {c.year} · {c.domain}</Eyebrow>
      <h1 class="font-display text-4xl md:text-6xl font-bold text-fg-strong mt-4 leading-[1.05]">
        {c.title}
      </h1>
      <p class="mt-8 text-lg md:text-xl text-muted leading-relaxed max-w-3xl">{c.summary}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {c.badges.map((b: string) => <Badge>{b}</Badge>)}
      </div>
    </div>
  </section>

  <!-- METRICS (if any) -->
  {
    c.metrics.length > 0 && (
      <section class="mx-auto max-w-4xl px-6 py-12">
        <MetricCallout metrics={c.metrics.map((m: { label: string; value: string }) => ({ label: m.label, value: m.value }))} />
      </section>
    )
  }

  <!-- NARRATIVE — CHALLENGE / APPROACH / OUTCOME -->
  <article class="mx-auto max-w-3xl px-6 py-16 space-y-16">
    <section>
      <div class="flex items-baseline gap-4 mb-4">
        <span class="font-display text-4xl font-bold text-accent leading-none">01</span>
        <SectionLabel>Challenge</SectionLabel>
      </div>
      <p class="text-lg text-fg leading-relaxed">{c.challenge}</p>
    </section>

    <section>
      <div class="flex items-baseline gap-4 mb-4">
        <span class="font-display text-4xl font-bold text-accent leading-none">02</span>
        <SectionLabel>Approach</SectionLabel>
      </div>
      <p class="text-lg text-fg leading-relaxed">{c.approach}</p>
    </section>

    <section>
      <div class="flex items-baseline gap-4 mb-4">
        <span class="font-display text-4xl font-bold text-accent leading-none">03</span>
        <SectionLabel>Outcome</SectionLabel>
      </div>
      <p class="text-lg text-fg leading-relaxed">{c.outcome}</p>
    </section>
  </article>

  <!-- RELATED CAPABILITIES -->
  {
    capabilities.length > 0 && (
      <section class="bg-bg-2 border-y border-border-hairline">
        <div class="mx-auto max-w-5xl px-6 py-16">
          <SectionLabel>Capabilities applied</SectionLabel>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-fg-strong mt-3 leading-tight">
            What we brought to this engagement.
          </h2>
          <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
            {capabilities.map((s) => (
              <Card href={`/services/${s.data.slug}`} accent>
                <div class="font-mono text-[10px] uppercase tracking-widest text-accent">
                  Capability · {s.data.number}
                </div>
                <h3 class="font-display text-lg font-bold text-fg-strong mt-2 leading-snug">
                  {s.data.title}
                </h3>
                <p class="mt-2 text-sm text-muted leading-relaxed">{s.data.summary}</p>
                <span class="mt-4 inline-block font-mono text-[10px] uppercase tracking-widest text-accent">
                  Read more →
                </span>
              </Card>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong leading-tight">
      Have a similar program?
    </h2>
    <p class="mt-4 text-muted leading-relaxed">
      Tell us what you're scoping. We respond within two business days with a candid read on fit.
    </p>
    <div class="mt-8 flex justify-center gap-3 flex-wrap">
      <Button href="/contact" variant="primary">Discuss a similar engagement</Button>
      <Button href="/experience" variant="outline">More case studies</Button>
    </div>
  </section>
</PageLayout>
