---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Button from "@components/Button.astro";
import CaseStudyCard from "@components/CaseStudyCard.astro";
import MetricCallout from "@components/MetricCallout.astro";
import PartnerMap from "@components/PartnerMap.astro";
import FromTheData from "@components/FromTheData.astro";
import SectionDivider from "@components/SectionDivider.astro";
import partnersData from "@/data/partners.json";
import { getCollection } from "astro:content";

interface Partner { section: string; agency: string; logo: string | null }
const partners = partnersData as Partner[];
const caseStudies = (await getCollection("caseStudies")).sort((a, b) => b.data.year - a.data.year);

const sectionOrder = [
  "Department of Homeland Security",
  "Department of War",
  "Additional Federal Entities",
  "International Entities",
  "Local Law Enforcement",
  "Organizations, Local Entities, National Labs",
  "Transit",
  "Airports",
];
const sectionDisplay: Record<string, string> = {
  "Additional Federal Entities": "Additional Federal",
  "International Entities": "International (FVEY & Partners)",
  "Organizations, Local Entities, National Labs": "Organizations, Tribal Nations & Labs",
  "Transit": "Transit & Class I Railroads",
};

const groups = sectionOrder.map((sec) => ({
  label: sectionDisplay[sec] ?? sec,
  items: partners.filter((p) => p.section === sec),
}));

const totalPartners = partners.length;
const totalSections = groups.length;
---
<PageLayout
  title="Relevant Experience"
  description="Past performance across federal, international, state, local, tribal, territorial, operational, and research divisions."
>
  <!-- HERO -->
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-12">
    <Eyebrow>Past Performance</Eyebrow>
    <h1 class="font-display text-5xl md:text-7xl font-bold text-fg-strong mt-4 leading-[1.05]">
      Relevant experience<br />across federal missions.
    </h1>
    <p class="mt-8 text-lg md:text-xl text-muted leading-relaxed max-w-3xl">
      Representative support provided to international, federal, state, local, tribal, territorial,
      operational, and research divisions. Additional details available upon request consistent
      with applicable disclosure restrictions.
    </p>
  </section>

  <!-- METRICS -->
  <section class="mx-auto max-w-5xl px-6 py-8">
    <MetricCallout
      metrics={[
        { label: "Mission Partners", value: String(totalPartners), emphasis: "+" },
        { label: "Sectors", value: String(totalSections) },
        { label: "Years Operating", value: String(new Date().getFullYear() - 2013), emphasis: "+" },
        { label: "Federal Domains", value: "8" },
      ]}
    />
  </section>

  <!-- CASE STUDIES -->
  {
    caseStudies.length > 0 && (
      <section class="bg-bg-2 border-y border-border-hairline">
        <div class="mx-auto max-w-6xl px-6 py-16">
          <SectionLabel>Selected case studies</SectionLabel>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
            Engagements in depth.
          </h2>
          <p class="mt-3 text-muted max-w-2xl leading-relaxed">
            Sanitized for public sharing. Full read-outs available upon request consistent with
            disclosure restrictions.
          </p>
          <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4">
            {caseStudies.map((c) => (
              <CaseStudyCard
                client={c.data.client}
                title={c.data.title}
                summary={c.data.summary}
                badges={c.data.badges}
                href={`/experience/${c.data.slug}`}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <SectionDivider variant="ticks" label="The data" />

  <!-- FROM THE DATA -->
  <FromTheData />

  <SectionDivider variant="compass" label="Footprint" />

  <!-- PARTNER MAP -->
  <PartnerMap />

  <SectionDivider variant="circuit" label="Partners" />

  <!-- MISSION PARTNERS GRID -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="flex items-end justify-between gap-8 flex-wrap mb-10">
      <div>
        <SectionLabel>Mission partners</SectionLabel>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong mt-3 leading-tight">
          Where we've operated.
        </h2>
        <p class="mt-3 text-muted max-w-2xl leading-relaxed">
          {totalPartners} agencies, services, and organizations across {totalSections} sectors —
          federal, international, transit, infrastructure.
        </p>
      </div>
    </div>

    <div class="space-y-14">
      {
        groups.map((g) => (
          <div>
            <div class="flex items-baseline justify-between gap-4 pb-3 mb-6 border-b border-border-hairline">
              <h3 class="font-display text-lg md:text-xl font-bold text-fg-strong">{g.label}</h3>
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
                {g.items.length} {g.items.length === 1 ? "partner" : "partners"}
              </span>
            </div>
            <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-6 gap-y-8">
              {g.items.map((p) => (
                <li
                  class="partner-tile group relative flex flex-col items-center text-center gap-3"
                  tabindex="0"
                  aria-label={`${p.agency} — ${g.label}`}
                >
                  {p.logo ? (
                    <div class="w-20 h-20 md:w-24 md:h-24 bg-surface border border-border-hairline rounded-md flex items-center justify-center p-2 shrink-0 transition-all group-hover:border-accent/60 group-hover:-translate-y-0.5 group-hover:shadow-lg group-focus-visible:border-accent/60">
                      <img
                        src={p.logo}
                        alt={p.agency}
                        loading="lazy"
                        width="96"
                        height="96"
                        class="max-w-full max-h-full object-contain"
                      />
                    </div>
                  ) : (
                    <div class="w-20 h-20 md:w-24 md:h-24 bg-surface border border-border-hairline rounded-md flex items-center justify-center text-muted font-mono text-[10px]">
                      —
                    </div>
                  )}
                  <span class="text-[11px] md:text-xs text-muted leading-tight">{p.agency}</span>

                  {/* Tooltip */}
                  <div class="partner-tooltip pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-3 z-20 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-150">
                    <div class="bg-bg/95 backdrop-blur-md border border-accent/40 rounded-md px-3 py-2 shadow-xl min-w-[200px] max-w-[280px] text-left">
                      <div class="font-mono text-[9px] uppercase tracking-[0.18em] text-accent">{g.label}</div>
                      <div class="mt-1 font-display text-sm font-bold text-fg-strong leading-snug">{p.agency}</div>
                    </div>
                    {/* Arrow */}
                    <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 rotate-45 bg-bg/95 border-r border-b border-accent/40"></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-surface border-y border-border-hairline">
    <div class="mx-auto max-w-5xl px-6 py-16 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 items-center">
      <div>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong leading-tight">
          Need a deeper read-out on past performance?
        </h2>
        <p class="mt-4 text-muted leading-relaxed max-w-xl">
          We can share detailed engagement histories — consistent with applicable disclosure
          restrictions — for any of the partners listed above.
        </p>
      </div>
      <div class="flex flex-col gap-3 shrink-0">
        <Button href="/contact" variant="primary">Request a briefing</Button>
        <Button href="/capabilities" variant="outline" size="sm">Capabilities statement</Button>
      </div>
    </div>
  </section>
</PageLayout>
