---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import CaseStudyCard from "@components/CaseStudyCard.astro";
import partnersData from "@/data/partners.json";
import { getCollection } from "astro:content";

interface Partner { section: string; agency: string; logo: string | null }
const partners = partnersData as Partner[];
const caseStudies = (await getCollection("caseStudies")).sort((a, b) => b.data.year - a.data.year);

// Friendly section ordering + display names
const sectionOrder = [
  "Department of Homeland Security",
  "Department of War",
  "Additional Federal Entities",
  "International Entities",
  "Local Law Enforcement",
  "Organizations, Local Entities, National Labs",
  "Transit",
  "Airports",
];
const sectionDisplay: Record<string, string> = {
  "Additional Federal Entities": "Additional Federal",
  "International Entities": "International (FVEY & Partners)",
  "Organizations, Local Entities, National Labs": "Organizations, Tribal Nations & Labs",
  "Transit": "Transit & Class I Railroads",
};

const groups = sectionOrder.map((sec) => ({
  label: sectionDisplay[sec] ?? sec,
  items: partners.filter((p) => p.section === sec),
}));
---
<PageLayout
  title="Relevant Experience"
  description="Past performance across federal, international, state, local, tribal, territorial, operational, and research divisions."
>
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-8">
    <SectionLabel>Past Performance</SectionLabel>
    <h1 class="font-display text-5xl md:text-6xl font-bold text-fg-strong mt-4 leading-tight">
      Relevant experience<br />across federal missions
    </h1>
    <p class="mt-6 text-base text-muted max-w-2xl leading-relaxed">
      Representative support provided to international, federal, state, local, tribal, territorial,
      operational, and research divisions. Additional details available upon request consistent
      with applicable disclosure restrictions.
    </p>
  </section>

  {
    caseStudies.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-12">
        <SectionLabel>Selected case studies</SectionLabel>
        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
          {caseStudies.map((c) => (
            <CaseStudyCard
              client={c.data.client}
              title={c.data.title}
              summary={c.data.summary}
              badges={c.data.badges}
              href={`/experience/${c.data.slug}`}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 pb-24 pt-12 border-t border-border-hairline">
    <SectionLabel>Mission partners</SectionLabel>
    <div class="mt-10 space-y-16">
      {
        groups.map((g) => (
          <div>
            <h2 class="font-display text-2xl font-bold text-fg-strong border-b border-border-hairline pb-3 mb-6">
              {g.label}
            </h2>
            <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-6 gap-y-8">
              {g.items.map((p) => (
                <li class="flex flex-col items-center text-center gap-3">
                  {p.logo ? (
                    <div class="w-20 h-20 md:w-24 md:h-24 bg-surface border border-border-hairline rounded-md flex items-center justify-center p-2 shrink-0">
                      <img
                        src={p.logo}
                        alt={p.agency}
                        loading="lazy"
                        width="96"
                        height="96"
                        class="max-w-full max-h-full object-contain"
                      />
                    </div>
                  ) : (
                    <div class="w-20 h-20 md:w-24 md:h-24 bg-surface border border-border-hairline rounded-md flex items-center justify-center text-muted font-mono text-[10px]">
                      —
                    </div>
                  )}
                  <span class="text-[11px] md:text-xs text-muted leading-tight">{p.agency}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</PageLayout>
