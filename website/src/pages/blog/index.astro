---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Eyebrow from "@components/Eyebrow.astro";
import Button from "@components/Button.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import { formatDate, readingTime } from "@lib/format";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date
);
const team = await getCollection("team");
function getAuthor(slugOrName: string) {
  return team.find((t) => t.data.slug === slugOrName || t.data.name === slugOrName);
}

const featured = posts[0];
const rest = posts.slice(1);
const tagSet = new Set<string>();
posts.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));
const tags = [...tagSet].sort();
---
<PageLayout title="Journal" description="Recent thinking on engineering rigor, T&E, and mission data.">
  <!-- HERO -->
  <section class="mx-auto max-w-4xl px-6 pt-20 pb-12">
    <Eyebrow>Journal</Eyebrow>
    <h1 class="font-display text-5xl md:text-7xl font-bold text-fg-strong mt-4 leading-[1.05]">
      Notes from the field.
    </h1>
    <p class="mt-8 text-lg md:text-xl text-muted leading-relaxed max-w-2xl">
      Short, structured pieces on how we think about defensible engineering, where rigor pays off,
      and patterns we see across federal programs. Less marketing, more notes.
    </p>
    {
      tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted self-center">Topics:</span>
          {tags.map((t) => (
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent border border-accent/25 px-2.5 py-1 rounded-sm">
              #{t}
            </span>
          ))}
        </div>
      )
    }
  </section>

  <!-- FEATURED POST -->
  {
    featured && (
      <section class="bg-bg-2 border-y border-border-hairline">
        <div class="mx-auto max-w-5xl px-6 py-16">
          <SectionLabel>Latest</SectionLabel>
          <a href={`/blog/${featured.id}`} class="group block mt-6">
            <h2 class="font-display text-3xl md:text-5xl font-bold text-fg-strong leading-[1.08] group-hover:text-accent transition-colors max-w-3xl">
              {featured.data.title}
            </h2>
            <p class="mt-5 text-lg text-muted leading-relaxed max-w-2xl">{featured.data.excerpt}</p>
            <div class="mt-6 flex items-center gap-4 font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
              <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
              <span>·</span>
              <span>{getAuthor(featured.data.author)?.data.name ?? featured.data.author}</span>
              <span>·</span>
              <span>{readingTime(featured.body ?? "")}</span>
              <span class="text-accent ml-2 group-hover:translate-x-1 transition-transform inline-block">→</span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <!-- REMAINING POSTS -->
  {
    rest.length > 0 && (
      <section class="mx-auto max-w-5xl px-6 py-16">
        <SectionLabel>Earlier</SectionLabel>
        <ul class="mt-8 divide-y divide-border-hairline">
          {rest.map((p) => (
            <li>
              <a href={`/blog/${p.id}`} class="group block py-8 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 items-baseline">
                <div>
                  <h3 class="font-display text-xl md:text-2xl font-bold text-fg-strong group-hover:text-accent transition-colors leading-snug">
                    {p.data.title}
                  </h3>
                  <p class="mt-3 text-sm md:text-base text-muted leading-relaxed">{p.data.excerpt}</p>
                  {p.data.tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {p.data.tags.map((t: string) => (
                        <span class="font-mono text-[9px] uppercase tracking-widest text-muted">
                          #{t}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <div class="md:text-right font-mono text-[10px] uppercase tracking-[0.18em] text-muted whitespace-nowrap">
                  <div>{formatDate(p.data.date)}</div>
                  <div class="mt-1">{readingTime(p.body ?? "")}</div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    posts.length === 0 && (
      <section class="mx-auto max-w-3xl px-6 py-20 text-center">
        <p class="text-muted">No entries yet. Check back soon.</p>
      </section>
    )
  }

  <!-- SUBSCRIBE STRIP -->
  <section class="bg-bg-2 border-y border-border-hairline">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <NewsletterSignup variant="card" source="blog-index" />
      <div class="mt-6 text-center">
        <a href="/rss.xml" class="font-mono text-[10px] uppercase tracking-widest text-muted hover:text-accent transition-colors">
          Prefer RSS? Subscribe to the feed ↗
        </a>
      </div>
    </div>
  </section>
</PageLayout>
