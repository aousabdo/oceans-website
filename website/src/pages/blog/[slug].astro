---
import PageLayout from "@layouts/PageLayout.astro";
import Button from "@components/Button.astro";
import ReadingProgress from "@components/ReadingProgress.astro";
import { formatDate, readingTime } from "@lib/format";
import { articleLd, breadcrumbLd } from "@lib/schema";
import { SITE_URL } from "@lib/seo";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const team = await getCollection("team");
  const sorted = posts.sort((a, b) => +b.data.date - +a.data.date);
  return posts.map((p) => {
    const idx = sorted.findIndex((x) => x.id === p.id);
    const author = team.find((t) => t.data.slug === p.data.author || t.data.name === p.data.author);
    return {
      params: { slug: p.id },
      props: {
        post: p,
        author,
        prev: idx < sorted.length - 1 ? sorted[idx + 1]! : null,
        next: idx > 0 ? sorted[idx - 1]! : null,
      },
    };
  });
}
const { post, author, prev, next } = Astro.props;
const { Content } = await render(post);
const ld = articleLd({
  title: post.data.title,
  description: post.data.excerpt,
  date: post.data.date,
  author: post.data.author,
  url: new URL(`/blog/${post.id}`, SITE_URL).toString(),
});
const crumbs = breadcrumbLd([
  ["Home", "/"],
  ["Journal", "/blog"],
  [post.data.title, `/blog/${post.id}`],
]);
---
<PageLayout title={post.data.title} description={post.data.excerpt} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <ReadingProgress target="main" />

  <!-- BACK LINK -->
  <div class="mx-auto max-w-3xl px-6 pt-12">
    <a href="/blog" class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-muted hover:text-fg-strong transition-colors">
      ← All journal entries
    </a>
  </div>

  <!-- ARTICLE HEADER -->
  <header class="mx-auto max-w-3xl px-6 pt-8 pb-12">
    {
      post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tags.map((t: string) => (
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent border border-accent/25 px-2.5 py-1 rounded-sm">
              #{t}
            </span>
          ))}
        </div>
      )
    }
    <h1 class="font-display text-4xl md:text-6xl font-bold text-fg-strong leading-[1.05]">
      {post.data.title}
    </h1>
    <p class="mt-6 text-lg md:text-xl text-muted leading-relaxed">{post.data.excerpt}</p>

    <div class="mt-10 flex flex-wrap items-center gap-5 pt-6 border-t border-border-hairline">
      {author?.data.portrait ? (
        <img
          src={author.data.portrait}
          alt={author.data.name}
          width="48"
          height="48"
          class="w-12 h-12 rounded-full object-cover border border-border-hairline"
          loading="lazy"
        />
      ) : (
        <div class="w-12 h-12 rounded-full bg-bg-2 border border-border-hairline grid place-items-center">
          <span class="font-display text-base font-bold text-accent">
            {post.data.author.charAt(0)}
          </span>
        </div>
      )}
      <div class="flex-1 min-w-0">
        <div class="font-display text-sm font-bold text-fg-strong">{author?.data.name ?? post.data.author}</div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-muted mt-0.5">
          {author?.data.role ?? "Contributor"}
        </div>
      </div>
      <div class="flex items-center gap-4 font-mono text-[10px] uppercase tracking-widest text-muted">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>·</span>
        <span>{readingTime(post.body ?? "")}</span>
      </div>
    </div>
  </header>

  <!-- BODY -->
  <article class="mx-auto max-w-2xl px-6 pb-20">
    <div
      class="text-fg leading-relaxed space-y-6
             [&_h2]:font-display [&_h2]:text-2xl [&_h2]:md:text-3xl [&_h2]:text-fg-strong [&_h2]:mt-14 [&_h2]:mb-4 [&_h2]:font-bold
             [&_h3]:font-display [&_h3]:text-xl [&_h3]:md:text-2xl [&_h3]:text-fg-strong [&_h3]:mt-10 [&_h3]:mb-3 [&_h3]:font-bold
             [&_p]:text-base [&_p]:md:text-lg [&_p]:leading-relaxed
             [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-accent/40 hover:[&_a]:decoration-accent
             [&_strong]:text-fg-strong [&_strong]:font-bold
             [&_em]:italic
             [&_code]:font-mono [&_code]:text-sm [&_code]:bg-bg-2 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded
             [&_ul]:list-disc [&_ul]:list-outside [&_ul]:pl-6 [&_ul]:space-y-2
             [&_ol]:list-decimal [&_ol]:list-outside [&_ol]:pl-6 [&_ol]:space-y-2
             [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-fg-strong [&_blockquote]:my-8
             [&_hr]:border-border-hairline [&_hr]:my-10"
    >
      <Content />
    </div>
  </article>

  <!-- PREV / NEXT POSTS -->
  {
    (prev || next) && (
      <section class="border-t border-border-hairline">
        <div class="mx-auto max-w-3xl px-6 py-10 grid grid-cols-2 gap-6">
          <div>
            {prev && (
              <a
                href={`/blog/${prev.id}`}
                class="group block bg-surface border border-border-hairline rounded-lg p-5 transition-all hover:border-accent/40"
              >
                <div class="font-mono text-[10px] uppercase tracking-widest text-muted">← Previous</div>
                <div class="mt-2 font-display text-base font-bold text-fg-strong group-hover:text-accent transition-colors line-clamp-2">
                  {prev.data.title}
                </div>
              </a>
            )}
          </div>
          <div>
            {next && (
              <a
                href={`/blog/${next.id}`}
                class="group block bg-surface border border-border-hairline rounded-lg p-5 text-right transition-all hover:border-accent/40"
              >
                <div class="font-mono text-[10px] uppercase tracking-widest text-muted">Next →</div>
                <div class="mt-2 font-display text-base font-bold text-fg-strong group-hover:text-accent transition-colors line-clamp-2">
                  {next.data.title}
                </div>
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="bg-bg-2 border-t border-border-hairline">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-fg-strong leading-tight">
        Working on something this touches?
      </h2>
      <p class="mt-3 text-muted leading-relaxed max-w-xl mx-auto">
        Reach out — we respond within two business days.
      </p>
      <div class="mt-6 flex justify-center gap-3 flex-wrap">
        <Button href="/contact" variant="primary" size="sm">Get in touch</Button>
        <Button href="/blog" variant="outline" size="sm">More from the journal</Button>
      </div>
    </div>
  </section>
</PageLayout>
