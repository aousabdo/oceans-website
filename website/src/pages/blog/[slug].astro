---
import PageLayout from "@layouts/PageLayout.astro";
import { formatDate, readingTime } from "@lib/format";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<PageLayout title={post.data.title} description={post.data.excerpt} type="article">
  <article class="mx-auto max-w-2xl px-6 pt-24 pb-24">
    <header>
      <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-widest text-muted">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>·</span>
        <span>{post.data.author}</span>
        <span>·</span>
        <span>{readingTime(post.body ?? "")}</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-fg-strong mt-4 leading-tight">
        {post.data.title}
      </h1>
      {
        post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((t: string) => (
              <span class="font-mono text-[9px] uppercase tracking-widest text-muted">#{t}</span>
            ))}
          </div>
        )
      }
    </header>
    <div
      class="mt-12 text-fg leading-relaxed space-y-5
             [&_h2]:font-display [&_h2]:text-2xl [&_h2]:text-fg-strong [&_h2]:mt-10 [&_h2]:mb-3
             [&_h3]:font-display [&_h3]:text-xl [&_h3]:text-fg-strong [&_h3]:mt-8 [&_h3]:mb-2
             [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2
             [&_strong]:text-fg-strong
             [&_ul]:list-disc [&_ul]:list-inside [&_ul]:space-y-1
             [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-4 [&_blockquote]:italic"
    >
      <Content />
    </div>
  </article>
</PageLayout>
