---
import PageLayout from "@layouts/PageLayout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import PullQuote from "@components/PullQuote.astro";
import { getCollection } from "astro:content";

const founders = (await getCollection("team"))
  .filter((t) => ["daniel-brent", "paul-morrisseau"].includes(t.data.slug))
  .sort((a, b) => a.data.order - b.data.order);

const yearsOperating = new Date().getFullYear() - 2012;

// Four values OCEANS holds itself to. Three plus the SDVOSB / service
// commitment — kept the original Discipline/Clarity/Integrity wording
// (those have been read by the team and are stable) and replaced the odd
// Jacksonville/Est. tile with a fourth value that ties to the veteran-
// owned designation.
const values = [
  {
    label: "Core Value",
    title: "Discipline",
    desc: "Structured methodology, traceability, and measurable criteria. Our work is deliberate, defensible, and repeatable.",
  },
  {
    label: "Core Value",
    title: "Clarity",
    desc: "Findings, metrics, and recommendations communicated in ways that support decision-making — technical, operational, and executive.",
  },
  {
    label: "Core Value",
    title: "Integrity",
    desc: "Objective, defensible results grounded in validated requirements. We take ownership of outcomes and ensure our work withstands review.",
  },
  {
    label: "Core Value",
    title: "Service",
    desc: "Service-Disabled Veteran-Owned Small Business. Started by a Navy veteran who knows what delivering for the mission actually requires.",
  },
];

// Core competencies match the four service lines published on /services so
// the about page and the rest of the site say the same thing. Previously
// this section listed generic capabilities that didn't match the service
// pages (Sensor Deployment, Enterprise Architecture, Systems Engineering,
// Operational Cybersecurity).
const competencies = [
  {
    title: "Requirements Development",
    desc: "Translating mission needs into structured, testable requirements with full traceability.",
  },
  {
    title: "Systems Engineering",
    desc: "Architecture, integration, and lifecycle cybersecurity for multi-component capabilities.",
  },
  {
    title: "RDT&E",
    desc: "Research, development, operational test & evaluation — assessment evidence that survives review.",
  },
  {
    title: "Mission Data",
    desc: "Ontology, schema, and Common Operating Picture design that preserves operational distinctions.",
  },
];
---
<PageLayout
  title="About"
  description="OCEANS LLC is a Service-Disabled Veteran-Owned Small Business in Jacksonville, FL — co-founded in 2012 by two engineers running federal programs the way the work actually requires."
>
  <!-- MASTHEAD -->
  <section class="mx-auto max-w-4xl px-6 pt-24 pb-16 text-center">
    <SectionLabel class="justify-center">Our Story</SectionLabel>
    <h1 class="font-display text-5xl md:text-7xl font-bold text-fg-strong mt-6 leading-[1.05]">
      Started in 2012.<br />Still doing the work.
    </h1>
    <p class="mt-8 text-lg md:text-xl text-muted leading-relaxed max-w-2xl mx-auto">
      OCEANS is a Service-Disabled Veteran-Owned Small Business out of Jacksonville, Florida — co-founded by two engineers who built the company to deliver federal engineering the way the work actually requires.
    </p>
  </section>

  <!-- FOUNDER PORTRAITS + ORIGIN STORY -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-12 md:gap-16 items-start">
      <!-- portrait stack -->
      <div class="flex md:flex-col gap-6">
        {
          founders.map((f) => (
            <div class="text-center">
              <img
                src={f.data.portrait}
                alt={f.data.name}
                width="160"
                height="160"
                loading="lazy"
                class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-full border-2 border-border-hairline shrink-0"
              />
              <div class="mt-3 font-display text-sm font-bold text-fg-strong">{f.data.name}</div>
              <div class="font-mono text-[9px] uppercase tracking-widest text-muted mt-1">
                {f.data.role}
              </div>
            </div>
          ))
        }
      </div>

      <!-- story -->
      <div class="space-y-5 text-fg leading-relaxed">
        <p class="text-lg">
          <strong class="text-fg-strong">Daniel Brent</strong> and
          <strong class="text-fg-strong">Paul Morrisseau</strong> met in Jacksonville, Florida — Dan
          was serving in the U.S. Navy at the time. Their work converged again at SRI International,
          where they spent years together on maritime and port security programs before deciding to
          build something of their own.
        </p>
        <p>
          In 2012 they founded OCEANS LLC. The thesis was simple. Federal programs deserve
          engineering that's disciplined, traceable, and willing to push back when a requirement
          won't survive operational scrutiny. A lot of firms claim that. Fewer actually run that way
          when the schedule tightens.
        </p>
        <p>
          Since then OCEANS has run through multiple presidential administrations and several
          government shutdowns without missing a deliverable. We do most of our work as direct
          support subcontractors on GSA MAS, OASIS+, SeaPort-NxG, and similar IDIQs — partnered with
          primes who need the engineering and program-management discipline they can't always staff
          in-house.
        </p>
        <p>
          Headquartered back in Jacksonville, where it started. {yearsOperating} years in.
        </p>
      </div>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="mx-auto max-w-4xl px-6 py-12">
    <PullQuote attribution="Founding principle, 2012">
      We don't take work we can't deliver well.
    </PullQuote>
  </section>

  <!-- CORE COMPETENCIES -->
  <section class="bg-bg-2 border-y border-border-hairline">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <SectionLabel>Core competencies</SectionLabel>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-fg-strong mt-3 leading-tight">
        Four service lines, one engagement lifecycle.
      </h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          competencies.map((c) => (
            <Card accent>
              <h3 class="font-display text-lg font-bold text-fg-strong">{c.title}</h3>
              <p class="mt-2 text-sm text-muted leading-relaxed">{c.desc}</p>
            </Card>
          ))
        }
      </div>
      <div class="mt-8">
        <Button href="/services" variant="outline" size="sm">All services</Button>
      </div>
    </div>
  </section>

  <!-- CORE VALUES -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <SectionLabel>What we hold ourselves to</SectionLabel>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        values.map((v) => (
          <Card>
            <div class="font-mono text-[9px] uppercase tracking-widest text-accent">{v.label}</div>
            <h3 class="font-display text-lg font-bold text-fg-strong mt-2">{v.title}</h3>
            <p class="mt-2 text-sm text-muted leading-relaxed">{v.desc}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <h2 class="font-display text-3xl md:text-4xl font-bold text-fg-strong leading-tight">
      Meet the people behind OCEANS.
    </h2>
    <p class="mt-4 text-muted leading-relaxed">
      Co-founders, domain directors, and senior architects running programs across federal mission
      domains.
    </p>
    <div class="mt-8 flex justify-center gap-3 flex-wrap">
      <Button href="/team" variant="primary">See the team</Button>
      <Button href="/contact" variant="outline">Start a conversation</Button>
    </div>
  </section>
</PageLayout>
