---
import BaseLayout from "./BaseLayout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article";
}
const props = Astro.props;
---
<BaseLayout {...props}>
  <Nav slot="nav" />
  <Footer slot="footer" />
  <slot />
</BaseLayout>
